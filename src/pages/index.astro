---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Recipes from '../components/Recipes.astro';
import Store from '../components/Store.astro';
import Trust from '../components/Trust.astro';
import Runs from '../components/Runs.astro';
import Capabilities from '../components/Capabilities.astro';
import Commands from '../components/Commands.astro';
import Install from '../components/Install.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <hr class="rule" />
    <HowItWorks />
    <hr class="rule" />
    <Recipes />
    <hr class="rule" />
    <Store />
    <hr class="rule" />
    <Trust />
    <hr class="rule" />
    <Runs />
    <hr class="rule" />
    <Capabilities />
    <hr class="rule" />
    <Commands />
    <Install />
  </main>
  <Footer />
</Layout>
