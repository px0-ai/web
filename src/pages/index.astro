---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Workflows from '../components/Workflows.astro';
import Recipes from '../components/Recipes.astro';
import Store from '../components/Store.astro';
import Trust from '../components/Trust.astro';
import DashboardPreview from '../components/DashboardPreview.astro';
import Capabilities from '../components/Capabilities.astro';
import Comparison from '../components/Comparison.astro';
import Commands from '../components/Commands.astro';
import Install from '../components/Install.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <hr class="rule" />
    <Workflows />
    <hr class="rule" />
    <Recipes />
    <hr class="rule" />
    <Store />
    <hr class="rule" />
    <Trust />
    <hr class="rule" />
    <DashboardPreview />
    <hr class="rule" />
    <Capabilities />
    <hr class="rule" />
    <Comparison />
    <hr class="rule" />
    <Commands />
    <Install />
  </main>
  <Footer />
</Layout>
