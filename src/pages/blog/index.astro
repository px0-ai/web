---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<Layout
  title="Blog & Engineering - px0"
  description="Technical deep dives, architectural notes, benchmarks, and essays from the px0 engineering team."
>
  <Nav />

  <main class="page-container">
    <div class="wrap">
      <header class="page-header">
        <div class="breadcrumbs">
          <a href="/">px0</a>
          <span class="crumb-sep">/</span>
          <span class="crumb-cur">blog</span>
        </div>
        <div class="headline-row">
          <div>
            <p class="kicker"><span>//</span> engineering articles & notes</p>
            <h1 class="page-title">Blog & Insights</h1>
          </div>
        </div>
        <p class="page-sub">
          Engineering retrospectives, systems design, performance benchmarks, and thoughts on developer tooling in the era of autonomous coding agents.
        </p>
      </header>

      <div class="posts-list">
        {posts.map((post) => (
          <article class="post-card">
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              <span class="meta-sep">&bull;</span>
              <span class="author">By {post.data.author}</span>
            </div>
            <h2 class="post-title">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h2>
            <p class="post-desc">{post.data.description}</p>
            <div class="post-tags">
              {post.data.tags.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .page-container {
    padding-top: calc(48px + 40px);
    padding-bottom: 80px;
    min-height: 80vh;
  }

  .page-header {
    margin-bottom: 48px;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: var(--txt-3);
    margin-bottom: 16px;
  }

  .breadcrumbs a {
    color: var(--txt-2);
  }

  .breadcrumbs a:hover {
    color: var(--amber);
  }

  .crumb-sep {
    color: var(--txt-4);
  }

  .crumb-cur {
    color: var(--amber);
  }

  .page-title {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--txt);
    margin-top: 6px;
  }

  .page-sub {
    font-size: 14px;
    line-height: 1.7;
    color: var(--txt-2);
    max-width: 680px;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 820px;
  }

  .post-card {
    border: 1px solid var(--bdr);
    background: var(--surface);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color 0.15s, background 0.15s;
  }

  .post-card:hover {
    border-color: var(--amber-line);
    background: var(--amber-wash);
  }

  .post-meta {
    font-size: 11.5px;
    color: var(--txt-3);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .meta-sep {
    color: var(--txt-4);
  }

  .post-title {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.4;
  }

  .post-title a {
    color: var(--txt);
    text-decoration: none;
    transition: color 0.15s;
  }

  .post-title a:hover {
    color: var(--amber);
  }

  .post-desc {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--txt-2);
  }

  .post-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .tag {
    font-size: 11px;
    color: var(--txt-3);
    background: var(--surface-2);
    padding: 2px 6px;
    border: 1px solid var(--bdr);
  }
</style>
