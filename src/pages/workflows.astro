  {
    id: 'operations-people',
    title: 'Operations, people, hiring',
    blurb: 'Recruiting loops, leave, timesheets, and vendor paperwork: high-friction, low-judgement, and almost entirely assembly.',
    rows: [
      ['Name candidates stuck in a stage for more than five days and whose action it is', 'greenhouse -> slack', 'daily 09:00'],
      ['Report the hiring funnel by role with pass-through rates per stage', 'lever -> googlesheets', 'Mon weekly'],
      ['Assemble the day-one pack for each new joiner: accounts, docs, first-week meetings', 'bamboohr -> notion, googlecalendar', 'daily 06:00'],
      ["Check next sprint's dates against booked time off and flag the collisions", 'bamboohr, jira -> slack', 'Thu weekly'],
      ['Chase whoever has not logged hours, one DM each, no channel shaming', 'clockify -> slack', 'Fri 17:00'],
      ['List vendor contracts expiring in the next forty-five days and their owner', 'docusign -> slack', 'Mon weekly'],
      ["Summarize this week's interview scorecards into a hiring-committee brief", 'ashby -> googledocs', 'Thu 18:00'],
    ],
  },
  {
    id: 'marketing-content',
    title: 'Marketing and content',
    blurb: 'Campaign reporting, competitor watching, and turning one published piece into the versions each platform wants.',
    rows: [
      ['Draft next week’s content calendar from the backlog, in the voice I write in', 'notion -> notion + guideline', 'Fri 14:00'],
      ['Turn the post I published into five platform-specific versions, queued not sent', 'firecrawl -> typefully, buffer', 'on demand'],
      ['Report campaign performance: opens, clicks, unsubscribes, and the subject that won', 'mailchimp, klaviyo -> slack', 'Tue weekly'],
      ['List keywords that dropped more than three positions this week', 'dataforseo -> googlesheets', 'Mon 07:00'],
      ["Watch our competitors' pricing pages and report only what actually changed", 'firecrawl -> slack', 'daily 08:00'],
      ['Split webinar registrants into attendees and no-shows and draft each follow-up', 'zoom -> mailchimp', 'on demand'],
      ['Summarize what people said about us on Reddit and Hacker News this week', 'reddit, exa -> slack', 'Fri 12:00'],
      ['Report which paid campaigns are burning budget below target conversion', 'metaads -> slack', 'daily 09:00'],
    ],
  },
  {
    id: 'personal-operations',
    title: 'Personal operations',
    blurb: 'The smallest workflows, and day to day the ones you notice most. They also need the fewest connectors to cover nearly all of this section.',
    rows: [
      ['Brief me on today’s meetings and the emails I have not replied to', 'googlecalendar, gmail -> file', 'daily 07:00'],
      ['At the end of the day, list everything I said I would do in Slack today', 'slack -> todoist', 'daily 18:30'],
      ['Show inbox debt: threads waiting on me for more than three days, oldest first', 'gmail -> slack', 'daily 16:00'],
      ['Audit last week’s calendar: meeting hours, focus hours, and the worst offender', 'googlecalendar -> googlesheets', 'Mon 08:00'],
      ['For each meeting tomorrow, attach the last three emails with those people', 'googlecalendar, gmail -> file', 'daily 19:00'],
      ['Pull receipts out of my mail this week and add a row per expense', 'gmail -> googlesheets', 'Sun 20:00'],
      ["Assemble the travel pack for tomorrow's trip: flights, hotel, times, documents", 'gmail, googlecalendar -> file', 'daily 20:00'],
    ],
  },
  {
    id: 'brain-grounded',
    title: 'Brain-grounded workflows',
    blurb: 'These need no connector. inputs: retrieve and a guideline are the whole apparatus, so they run offline and cost nothing to authorize. Start here.',
    rows: [
      ['Digest what I saved this week and name the thread running through it', 'retrieve -> file', 'Sun 18:00'],
      ['Review this design doc against the notes I have kept on distributed systems', 'retrieve, github -> github', 'on demand'],
      ['Draft a blog post from the three papers I read on backpressure, citing each', 'retrieve -> file + guideline', 'on demand'],
      ['Build an interview question sheet from my saved system-design notes', 'retrieve -> file', 'on demand'],
      ['Tell me what I have read that contradicts the claim in this PR description', 'retrieve, github -> file', 'on demand'],
      ['Answer support questions in my words, using only what my brain actually says', 'retrieve, zendesk -> zendesk', 'on demand'],
    ],
  },
];

const totalRows = categories.reduce((n, c) => n + c.rows.length, 0);

const pipelines = [
  {
    name: 'Friday wrap',
    stages: ['pr-digest', 'incident-digest', 'ticket-themes', 'weekly-post'],
    why: 'Three read-only collectors and one write. Each stage survives mid-week on its own.',
  },
  {
    name: 'Release train',
    stages: ['commits-since-tag', 'changelog-draft', 'release-page'],
    why: 'The draft stage holds the guideline, so the voice is fixed in one place.',
  },
  {
    name: 'Morning desk',
    stages: ['calendar-brief', 'inbox-debt', 'overnight-alerts', 'morning-brief'],
    why: 'One 07:00 cron instead of four, and one file to read.',
  },
  {
    name: 'Manager Monday',
    stages: ['sprint-status', 'blocked-list', 'stalled-wip', 'team-status'],
    why: 'The collectors are the ones an engineer runs alone, reused at team scope.',
  },
  {
    name: 'Monthly business review',
    stages: ['revenue-movement', 'funnel-movement', 'support-themes', 'mbr-doc'],
    why: 'Only the writer stage touches a document, so the write surface is one tool.',
  },
];
---

<Layout
  title="Workflow catalogue — px0"
  description={`Here are some jobs you could build with px0, each written as the one sentence you would type into px0 workflows new.`}
>
  <Nav />
  <main>
    <header class="section wf-hero">
      <div class="container">
        <span class="eyebrow reveal">workflow catalogue</span>
        <h1 class="wf-h1 reveal">Some workflows you could build with px0</h1>
        <p class="sub wf-lede reveal">
          Each row is one sentence you would type into <code class="inline-code">px0 workflows new</code>.
          This page is a catalogue and inspiration of ideas, not a set of shipped workflows: px0 ships none, and
          every row here is one command away from existing in your store.
        </p>
      </div>
    </header>

    <hr class="rule" />

    <section class="section section--tight" id="how-to-read">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">how to read a row</span>
          <h2 class="h-section">Five things every row tells you</h2>
        </div>
        <div class="htr-grid reveal">
          {howToRead.map((h) => (
            <div class="htr-item">
              <h3>{h.title}</h3>
              <p>{h.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="section section--tight" id="moves">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">what the format supports</span>
          <h2 class="h-section">Five moves, one constraint each</h2>
          <p class="sub">
            Every row below is a variation on these. The constraint column is what decides whether
            an idea is buildable.
          </p>
        </div>

        <div class="moves-wrap reveal">
          <table class="moves-table">
            <thead>
              <tr><th>move</th><th>what it gives a workflow</th><th>the constraint that shapes it</th></tr>
            </thead>
            <tbody>
              {moves.map(([move, gives, constraint]) => (
                <tr>
                  <td><code class="inline-code">{move}</code></td>
                  <td>{gives}</td>
                  <td class="s-dim">{constraint}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="section" id="catalogue">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">the catalogue</span>
          <h2 class="h-section">Twelve categories, {totalRows} rows</h2>
          <p class="sub">
            Reads are cyan, writes are amber, and anything that stays on this machine — <code class="inline-code">retrieve</code>,
            <code class="inline-code">file</code> — is left uncoloured.
          </p>
        </div>

        <nav class="wf-jump reveal" aria-label="Jump to category">
          {categories.map((c) => (
            <a href={`#${c.id}`} class="wf-jump-pill">
              {c.title}<span class="wf-jump-count">{c.rows.length}</span>
            </a>
          ))}
          <a href="#pipelines" class="wf-jump-pill wf-jump-pill--pipe">Pipelines</a>
        </nav>

        {categories.map((c) => (
          <div class="wf-cat reveal" id={c.id}>
            <div class="wf-cat-head">
              <h3>{c.title}</h3>
              <span class="chip">{c.rows.length} workflows</span>
            </div>
            <p class="wf-cat-blurb">{c.blurb}</p>

            <div class="wf-table-wrap">
              <table class="wf-table">
                <thead>
                  <tr><th>what you would type</th><th>reads</th><th>writes</th><th>cadence</th></tr>
                </thead>
                <tbody>
                  {c.rows.map(([ask, apps, cadence]) => {
                    const { reads, writes, guideline } = parseApps(apps);
                    return (
                      <tr>
                        <td class="wf-ask">“{ask}”</td>
                        <td class="wf-apps">
                          {reads.map((a) => (
                            LOCAL.has(a) ? <span class="wf-local">{a}</span> : <span class="mark mark--read">{a}</span>
                          ))}
                        </td>
                        <td class="wf-apps">
                          {writes.map((a) => (
                            LOCAL.has(a) ? <span class="wf-local">{a}</span> : <span class="mark mark--write">{a}</span>
                          ))}
                          {guideline && <span class="wf-guideline">+ guideline</span>}
                        </td>
                        <td>
                          <span class:list={['wf-cadence', { 'wf-cadence--demand': cadence === 'on demand' }]}>{cadence}</span>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="rule" />

    <section class="section" id="pipelines">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">compositions</span>
          <h2 class="h-section">Worth building as pipelines</h2>
          <p class="sub">
            A pipeline is one job made of workflows, one level deep. That constraint suits a
            specific shape: several narrow collectors, then one writer that reads all of them.
          </p>
        </div>

        <div class="pipe-grid reveal">
          {pipelines.map((p) => (
            <article class="pipe-card">
              <h3>{p.name}</h3>
              <div class="pipe-stages">
                {p.stages.map((s, i) => (
                  <>
                    <code>{s}</code>
                    {i < p.stages.length - 1 && (
                      <svg class="pipe-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    )}
                  </>
                ))}
              </div>
              <p>{p.why}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="section section--tight" id="build-one">
      <div class="container">
        <div class="wf-cta reveal">
          <div>
            <span class="eyebrow">pick one</span>
            <h2 class="h-section">Every row is one command away</h2>
            <p class="sub">
              Type the sentence, review the tools px0 resolved, and check it before it touches
              anything real.
            </p>
          </div>
          <div class="term wf-cta-term">
            <div class="term-bar">
