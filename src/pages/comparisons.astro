---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const cols = [
  'px0',
  'Hermes Agent',
  'OpenClaw',
  'CrewAI / LangGraph',
  'n8n / Dify',
  'Open-Interpreter',
  'Khoj / PKM Copilot',
];

// true = yes, false = no, null = not verified for that product. The px0 column
// is checked against the CLI and kept current with it; the other columns were
// compiled when this page was written, so a factor added later is marked
// unknown rather than guessed at.
type Row = { factor: string; def: string; vals: (boolean | null)[] };

const rows: Row[] = [
  {
    factor: 'Natural language workflow creation',
    def: 'Describe an end-to-end multi-step job in plain English and have the system synthesize a complete, runnable routine.',
    vals: [true, false, false, false, false, false, false],
  },
  {
    factor: 'Human-editable Markdown workflows',
    def: 'Workflows live on disk as Markdown/YAML you can open, hand-edit, or version, with no compiler or database in the way.',
    vals: [true, false, false, false, false, false, false],
  },
  {
    factor: 'Zero-server, local-first CLI operation',
    def: 'Runs entirely on your laptop or workstation, with no cloud infrastructure, hosted account, or control plane.',
    vals: [true, false, false, false, false, true, true],
  },
  {
    factor: 'Native unattended scheduler',
    def: 'A built-in background scheduler triggers tasks at scheduled times without a terminal session left open.',
    vals: [true, true, false, false, true, false, false],
  },
  {
    factor: 'Reactive tool polling / event watcher',
    def: 'Polls read-only tools or feeds at intervals and fires a workflow only when a new event or condition appears.',
    vals: [true, false, false, false, true, false, false],
  },
  {
    factor: '1,000+ external SaaS connectors',
    def: 'Native integration with hundreds of apps (GitHub, Slack, Jira, Linear, Sentry, Notion, Sheets) with no custom API client to write.',
    vals: [true, false, false, false, false, false, false],
  },
  {
    factor: 'Local vault / second-brain ingest',
    def: 'Indexes and searches local Markdown note repositories, PDFs, and saved pages natively, with no cloud lock-in.',
    vals: [true, false, false, false, false, false, true],
  },
  {
    factor: 'Reuses existing coding CLI logins',
    def: 'Executes model inference through a CLI you already have logged in (claude, gemini, pi, opencode) instead of a separate API key.',
    vals: [true, false, false, false, false, false, false],
  },
  {
    factor: 'Custom style guidelines inlined verbatim',
    def: 'Dedicated guideline files (commit rules, review tone) get inlined into prompts verbatim, so output matches your voice.',
    vals: [true, false, false, false, false, false, false],
  },
  {
    factor: 'Local custom tool definitions (TOML/CLI)',
    def: 'Exposes local bash scripts and terminal commands as modular tools through lightweight declarative definitions.',
    vals: [true, true, true, true, true, false, false],
  },
  {
    factor: 'Dry-run mode for workflow verification',
    def: 'Tests structure, resolves real inputs, and previews planned actions before any real external API is called.',
    vals: [true, false, false, false, true, false, false],
  },
  {
    factor: 'Workflow change history & rollback',
    def: 'Snapshots every modification automatically, so you can inspect prior versions and revert an accidental edit.',
    vals: [true, false, false, false, false, false, false],
  },
  {
    factor: 'Multi-channel chat gateway',
    def: 'Connects agents into team chat platforms as persistent bots, conversing across Discord, Telegram, and similar channels.',
    vals: [false, true, true, false, true, false, false],
  },
  {
    factor: 'Persistent memory of the user',
    def: 'Standing facts about you (preferences, people, projects) carried into every later run rather than re-established each time. px0 keeps one versioned Markdown file per fact and drafts new ones from your corrections, but never writes one without being asked. That limit is the design, not a gap: an assistant that silently accumulates unreviewable beliefs about you is the failure mode it avoids.',
    vals: [true, true, false, false, false, false, null],
  },
  {
    factor: 'Writes held for human approval',
    def: 'A tool call that would leave a mark can be drafted rather than fired, shown in full with the output that prompted it, and sent only once a person agrees. The run itself still completes.',
    vals: [true, null, null, null, null, false, false],
  },
  {
    factor: 'Self-review from its own run history',
    def: 'The system reads its own past runs to say what is wrong with a workflow, and proposes a revision you can replay against the inputs a real past run had before accepting it.',
    vals: [true, null, null, null, null, false, false],
  },
  {
    factor: 'Multi-agent orchestration & delegation',
    def: 'Native primitives for running distinct agents (research, coder, reviewer) that pass messages and sub-tasks to each other.',
    vals: [false, true, true, true, false, false, false],
  },
  {
    factor: 'Full Python / TypeScript code framework',
    def: 'A developer-centric SDK that requires code, class inheritance, and custom logic to build an agent workflow.',
    vals: [false, false, false, true, false, false, false],
  },
  {
    factor: 'Drag-and-drop visual graph canvas',
    def: 'A web UI for connecting nodes, routers, and logic branches on a visual canvas.',
    vals: [false, false, false, false, true, false, false],
  },
  {
    factor: 'Interactive terminal REPL pair coding',
    def: 'An interactive command-line session where an agent plans, executes shell commands, and iterates with you in real time.',
    vals: [false, false, false, false, false, true, false],
  },
];

const offerings = [
  {
    name: 'px0',
    tag: 'you are here',
    overview: 'A local-first workflow compiler, scheduler, and knowledge assistant CLI.',
    use: 'Personal recurring automations and unattended chores (triage reports, sprint summaries, release notes), plus querying your own Obsidian vault alongside 1,000+ apps via Composio.',
    strength: 'Turns plain English into transparent, editable Markdown files that run locally on a schedule using a CLI login you already have.',
  },
  {
    name: 'Hermes Agent',
    sub: 'Nous Research',
    overview: 'An autonomous, self-improving persistent AI agent framework.',
    use: 'Long-running "digital employee" workflows where the agent curates its own memory, learns skills from experience, and keeps running across sessions.',
    strength: 'Deep autonomous memory loops, mixture-of-agents reasoning, and persistent agent evolution.',
  },
  {
    name: 'OpenClaw',
    overview: 'An orchestration gateway that manages and routes multi-agent teams across messaging channels.',
    use: 'Running a team of specialized bots (research, coding, operations) across Slack, Discord, Telegram, and WhatsApp.',
    strength: 'Centralized multi-agent routing, gateway management, and cross-channel messaging adapters.',
  },
  {
    name: 'CrewAI / LangGraph',
    overview: 'Developer-first code frameworks for building multi-agent architectures and stateful agent graphs.',
    use: 'Custom enterprise AI applications, complex branching pipelines, and bespoke multi-agent systems written in Python or TypeScript.',
    strength: 'Maximum programmatic flexibility, granular control over state machines, and a rich ecosystem.',
  },
  {
    name: 'n8n / Dify',
    overview: 'Low-code visual workflow automation platforms and LLM app builders.',
    use: 'Visual API orchestration, company-wide webhooks, ETL pipelines, and node-based AI chaining.',
    strength: 'An accessible drag-and-drop canvas, a vast visual node ecosystem, and a team-accessible web UI.',
  },
  {
    name: 'Open-Interpreter',
    overview: 'An open-source, interactive terminal copilot for local code execution and system control.',
    use: 'Interactive pair programming, running local scripts, analyzing local datasets, and controlling desktop apps via chat.',
    strength: 'A real-time terminal execution loop and interactive local machine pair-working.',
  },
  {
    name: 'Khoj / PKM Copilots',
    sub: 'Obsidian, Logseq',
    overview: 'AI assistants embedded in personal knowledge management tools.',
    use: 'Semantic search, question-answering across personal notes, and drafting content based on local notes.',
    strength: 'Deep note-level integration and local document retrieval for personal knowledge.',
  },
];
---

<Layout
  title="px0 vs. the field: comparisons"
  description="How px0 compares to Hermes Agent, OpenClaw, CrewAI/LangGraph, n8n/Dify, Open-Interpreter, and Khoj across 21 capability factors."
>
  <Nav />
  <main>
    <header class="section cmp-hero">
      <div class="container">
        <span class="eyebrow reveal">comparisons</span>
        <h1 class="cmp-h1 reveal">px0 vs. the field</h1>
        <p class="sub cmp-lede reveal">
          px0 sits at the intersection of a few categories: agent frameworks, workflow
          automation, and personal knowledge tools, without quite being any one of them.
        </p>
      </div>
    </header>

    <hr class="rule" />

    <section class="section" id="matrix">
      <div class="container">

        <div class="cmp-table-wrap reveal">
          <table class="cmp-table">
            <thead>
              <tr>
                <th scope="col"><span class="s-dim">factor</span></th>
                {cols.map((c, i) => (
                  <th scope="col" class={i === 0 ? 'is-px0' : ''}>{c}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <th scope="row" class="factor-cell">
                    <span class="has-tooltip">{r.factor}</span>
                    <div class="cmp-tooltip" role="tooltip">{r.def}</div>
                  </th>
                  {r.vals.map((v) => (
                    <td>
                      {v === true ? (
                        <span class="cmp-yes" aria-label="yes">
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                        </span>
                      ) : v === null ? (
                        <span class="cmp-unk" aria-label="not verified">?</span>
                      ) : (
                        <span class="cmp-no" aria-hidden="true">&ndash;</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="cmp-caveat reveal">
          The px0 column is checked against the CLI and kept current with it. The other columns
          reflect each project’s public documentation and behavior at time of writing, and a
          factor added since is marked <strong>?</strong> rather than guessed at. Fast-moving
          projects change; verify a factor yourself before it drives a decision.
        </p>
      </div>
    </section>


  </main>
  <Footer />
</Layout>

<style>
  .cmp-hero {
    padding-top: 128px;
    padding-bottom: 48px;
  }

  .cmp-h1 {
    font-family: var(--display);
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 18px;
  }

  .cmp-lede {
    max-width: 640px;
    font-size: 16px;
  }

  /* ── matrix table (shared shape with the index teaser) ── */
  .cmp-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--bdr);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .cmp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .cmp-table th,
  .cmp-table td {
    padding: 12px 16px;
    text-align: center;
    border-bottom: 1px solid var(--bdr);
    white-space: nowrap;
  }

  .cmp-table tbody tr:last-child th,
  .cmp-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .cmp-table thead th {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--txt-3);
    font-weight: 500;
  }

  .cmp-table thead th.is-px0 {
    color: var(--amber);
  }

  .cmp-table th[scope='row'] {
    text-align: left;
    white-space: normal;
    min-width: 240px;
    font-size: 13px;
    font-weight: 500;
    color: var(--txt-2);
    position: sticky;
    left: 0;
    background: var(--bg-elev);
  }

  .cmp-table tbody tr:hover {
    background: var(--surface-2);
  }

  .cmp-yes {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    color: var(--green);
    border: 1px solid color-mix(in srgb, var(--green) 34%, transparent);
    background: color-mix(in srgb, var(--green) 10%, transparent);
  }

  .cmp-no {
    color: var(--txt-4);
  }

  .cmp-unk {
    color: var(--txt-4);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .cmp-caveat {
    margin-top: 16px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--txt-3);
    max-width: 620px;
  }

  /* ── tooltips ── */
  .factor-cell {
    position: relative;
    cursor: help;
  }

  .has-tooltip {
    border-bottom: 1px dotted var(--txt-3);
  }

  .cmp-tooltip {
    position: absolute;
    bottom: 100%;
    left: 16px;
    margin-bottom: 8px;
    width: 280px;
    padding: 12px 14px;
    background: var(--surface-solid);
    border: 1px solid var(--bdr);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-float);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--txt);
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
    z-index: 10;
    pointer-events: none;
    text-transform: none;
    letter-spacing: normal;
  }

  .factor-cell:hover .cmp-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .cmp-hero { padding-top: 108px; }
    .cmp-table th[scope='row'] { min-width: 180px; }
  }
</style>
