---
import '../styles/global.css';
import { GITHUB, RELEASES, AUTHOR, EMAIL, VERSION } from '../data/links';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "px0: a fast, lightweight, read-only IDE",
  description = "px0 is a fast, lightweight, read-only IDE designed for instant code navigation and review in your browser. Booting in under 1 ms and using ~16 MB of RAM, it turns your browser into a zero-latency inspection console with symbol-level navigation, deep search, and syntax highlighting across massive codebases.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://px0.ai');
const ogImage = new URL('/cover.png', Astro.site || 'https://px0.ai').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />

    <!-- Apple Touch Icons -->
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="apple-touch-icon" sizes="57x57" href="/apple-icon-57x57.png" />
    <link rel="apple-touch-icon" sizes="60x60" href="/apple-icon-60x60.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="/apple-icon-72x72.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/apple-icon-76x76.png" />
    <link rel="apple-touch-icon" sizes="114x114" href="/apple-icon-114x114.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-icon-120x120.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/apple-icon-144x144.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png" />

    <!-- Android / PWA -->
    <link rel="manifest" href="/manifest.json" />

    <!-- Windows Tiles -->
    <meta name="msapplication-TileColor" content="#06070b" />
    <meta name="msapplication-TileImage" content="/ms-icon-144x144.png" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="theme-color" content="#06070b" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      const stored = (() => {
        try {
          return localStorage.getItem('theme');
        } catch (e) {
          return null;
        }
      })();
      const theme =
        stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', theme);
    </script>

    <!-- Canonical & discoverability -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="help" type="text/markdown" href="/llms.txt" title="LLM-friendly content index" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="px0, read code fast, read-only IDE, code viewer, code navigator, lightweight IDE, code reading, code review, instant code inspection, fuzzy file finder, go to definition, find references, LSP, gopls, rust-analyzer, clangd, syntax highlighting, Chroma, project search, regex search, single binary, Go, open source, VS Code alternative"
    />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Arpit Bhayani" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content="px0: fast, lightweight, read-only IDE" />
    <meta property="og:site_name" content="px0" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="px0: fast, lightweight, read-only IDE" />

    <!-- Structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'px0',
      softwareVersion: VERSION,
      description:
        'px0 is a fast, lightweight, read-only IDE designed for instant code navigation and review in your browser. Booting in under 1 ms and using ~16 MB of RAM, it turns your browser into a zero-latency inspection console with symbol-level navigation, deep search, and syntax highlighting across massive codebases.',
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Code Viewer, Code Navigation, IDE',
      operatingSystem: 'macOS, Linux, FreeBSD, OpenBSD, NetBSD, Windows',
      url: 'https://px0.ai',
      downloadUrl: RELEASES,
      codeRepository: GITHUB,
      license: 'https://opensource.org/licenses/MIT',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: {
        '@type': 'Person',
        name: 'Arpit Bhayani',
        email: EMAIL,
        url: AUTHOR,
      },
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is px0?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'px0 is a fast, lightweight, read-only IDE designed for instant code navigation and review in your browser. It boots in under 1 millisecond and uses approximately 16 MB of RAM, turning your browser into a zero-latency code inspection console.',
          },
        },
        {
          '@type': 'Question',
          name: 'Why use a read-only IDE instead of a full editor like VS Code?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'With AI coding agents and CLI tools writing code, developers spend most of their time in verification, audit, and navigation. Full desktop IDEs take seconds to boot and consume 1.4+ GB of RAM just to read files. px0 starts in under 1 ms with ~16 MB RAM, providing zero-latency code reading without editor bloat.',
          },
        },
        {
          '@type': 'Question',
          name: 'Does px0 require language servers to work?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Language servers are completely optional. px0 automatically detects servers like gopls, rust-analyzer, or clangd on your PATH if present, but falls back instantly to a built-in regex-based outline and fuzzy search if no server is installed.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does px0 handle large repositories?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'px0 uses windowed syntax highlighting and virtual DOM rendering (only rendering visible rows on screen), so opening a 400,000-line file costs the same as a 10-line file. It fuzzy-finds across the Linux kernel (95,710 files) in 6 ms.',
          },
        },
        {
          '@type': 'Question',
          name: 'How do I install px0?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Run `curl -fsSL https://px0.ai/install.sh | bash` on macOS, Linux, or BSD. Prebuilt binaries for 15 OS and architecture targets are also available on GitHub Releases.',
          },
        },
      ],
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="atmos" aria-hidden="true">
      <div class="atmos-glow"></div>
      <div class="atmos-grid"></div>
      <div class="atmos-scan"></div>
    </div>
    <slot />

    <script>
      // Scroll reveal, shared by every section.
      const items = document.querySelectorAll('.reveal');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && items.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        items.forEach((el, i) => {
          (el as HTMLElement).style.transitionDelay = `${Math.min(i % 6, 5) * 50}ms`;
          io.observe(el);
        });
      } else {
        items.forEach((el) => el.classList.add('in'));
      }

      // Copy-to-clipboard for any [data-copy] element.
      document.querySelectorAll<HTMLElement>('[data-copy]').forEach((el) => {
        el.addEventListener('click', async () => {
          const text = el.dataset.copy || '';
          try {
            await navigator.clipboard.writeText(text);
          } catch (e) {
            return;
          }
          el.classList.add('copied');
          window.setTimeout(() => el.classList.remove('copied'), 1600);
        });
      });

      // Show Mac modifier glyphs to Mac visitors.
      if (/Mac|iPhone|iPad/.test(navigator.userAgent)) {
        const glyphs: Record<string, string> = { 'mod-key': '⌘', 'shift-key': '⇧', 'alt-key': '⌥' };
        for (const [cls, glyph] of Object.entries(glyphs)) {
          document.querySelectorAll(`.${cls}`).forEach((el) => (el.textContent = glyph));
        }
      }
    </script>
  </body>
</html>
