---
const tree = [
  { pad: 0, glyph: '', name: '~/.px0', note: 'your store, move it with PX0_HOME', kind: 'root' },
  { pad: 1, glyph: '├──', name: 'workflows/', note: 'the jobs px0 can run', kind: 'dir' },
  { pad: 2, glyph: '│   ├──', name: 'friday-pr-digest.md', note: '', kind: 'file' },
  { pad: 2, glyph: '│   └──', name: 'morning-brief.md', note: '', kind: 'file' },
  { pad: 1, glyph: '├──', name: 'guidelines/', note: 'how you work', kind: 'dir' },
  { pad: 2, glyph: '│   ├──', name: 'commit-messages.md', note: '', kind: 'file' },
  { pad: 2, glyph: '│   └──', name: 'code-review/go.md', note: '', kind: 'file' },
  { pad: 1, glyph: '├──', name: 'brain/', note: 'what you have read and kept', kind: 'dir' },
  { pad: 2, glyph: '│   ├──', name: 'blogs/  papers/  docs/', note: '', kind: 'file' },
  { pad: 2, glyph: '│   └──', name: 'work/', note: 'never leaves this machine', kind: 'private' },
  { pad: 1, glyph: '├──', name: 'output/', note: 'what runs produced', kind: 'dir' },
  { pad: 1, glyph: '└──', name: 'config.toml', note: '', kind: 'file' },
];

const pillars = [
  {
    tag: 'guidelines/',
    title: 'It writes in your voice',
    body: 'Guidelines are Markdown files describing your conventions: how you word a commit message, what your Go reviews check. A workflow that needs one inlines it verbatim, so output comes back sounding like you instead of like a model.',
    cmd: 'px0 guidelines edit',
    accent: 'var(--violet)',
  },
  {
    tag: 'brain/',
    title: 'A library you can question',
    body: 'Add posts, papers, docs, and video transcripts as you read them. Text is extracted locally and indexed, so you can ask questions across everything you kept, with the passages it used cited back.',
    cmd: 'px0 brain ask "…"',
    accent: 'var(--cyan)',
  },
  {
    tag: '.state/',
    title: 'Its own history, no git',
    body: 'Every version of every file is kept by px0 itself, so the store works as a bare directory. Hand-edit a workflow and the next run picks it up; the edit still shows up in the log, and still reverts.',
    cmd: 'px0 changes revert <id>',
    accent: 'var(--green)',
  },
];
---

<section class="section" id="store">
  <div class="container">
    <div class="store-grid">
      <div class="store-copy reveal">
        <span class="eyebrow">your machine, your files</span>
        <h2 class="h-section">A directory, not a dashboard</h2>
        <p class="sub">
          There is no server to sign into and no hosted state to lose. Everything px0 knows is
          plain Markdown in one directory you own: open it in any editor, grep it, back it up,
          delete it. Edit a workflow by hand and the next run picks it up, with no compile step
          in between.
        </p>

        <ul class="store-points">
          <li><strong>Runs locally.</strong> The model backend is a coding agent CLI you already sign into.</li>
          <li><strong>No account.</strong> Nothing to create, nothing to cancel, no seat to pay for.</li>
          <li><strong>Portable.</strong> <code class="inline-code">px0 store export</code> copies content and history anywhere.</li>
          <li><strong>Traceable.</strong> <code class="inline-code">px0 runs why</code> retraces a result to the guidelines, passages, and tool calls behind it, and a fire your laptop slept through still runs when it wakes.</li>
        </ul>
      </div>

      <div class="store-tree card reveal">
        <div class="tree-bar">
          <span class="tree-title">~/.px0</span>
          <span class="tree-meta">plain markdown</span>
        </div>
        <div class="tree-body">
          {tree.map((n) => (
            <div class:list={['tline', `k-${n.kind}`]}>
              <span class="tglyph">{n.glyph}</span>
              <span class="tname">{n.name}</span>
              {n.note && <span class="tnote">{n.note}</span>}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="pillars">
      {pillars.map((p) => (
        <article class="pillar card reveal" style={`--accent:${p.accent}`}>
          <span class="p-tag">{p.tag}</span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
          <code class="p-cmd">{p.cmd}</code>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .store-grid {
    display: grid;
    grid-template-columns: minmax(0, 44fr) minmax(0, 56fr);
    gap: 56px;
    align-items: center;
  }

  .store-points {
    list-style: none;
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .store-points li {
    position: relative;
    padding-left: 20px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--txt-2);
  }

  .store-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 7px;
    height: 7px;
    border-radius: 0;
    background: var(--amber);
    box-shadow: 0 0 12px var(--amber-glow);
  }

  .store-points strong {
    color: var(--txt);
    font-weight: 600;
  }

  /* ── tree ── */
  .store-tree {
    overflow: hidden;
    background: var(--bg-elev);
  }

  .tree-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    border-bottom: 1px solid var(--bdr);
    background: var(--surface);
  }

  .tree-title,
  .tree-meta {
    font-family: var(--mono);
    font-size: 11.5px;
  }

  .tree-title { color: var(--txt-2); }
  .tree-meta { color: var(--txt-3); }

  .tree-body {
    padding: 18px 20px 22px;
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 2.05;
    overflow-x: auto;
  }

  .tline {
    display: flex;
    align-items: baseline;
    gap: 10px;
    white-space: nowrap;
  }

  .tglyph {
    color: var(--txt-4);
    flex-shrink: 0;
  }

  .tname { color: var(--txt-2); }

  .k-root .tname { color: var(--txt); font-weight: 600; }
  .k-dir .tname { color: var(--amber); }
  .k-private .tname { color: var(--rose); }

  .tnote {
    color: var(--txt-4);
    font-size: 11px;
  }

  .tnote::before {
    content: '· ';
  }

  .k-private .tnote { color: color-mix(in srgb, var(--rose) 70%, var(--txt-3)); }

  /* ── pillars ── */
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 68px;
  }

  .pillar {
    padding: 26px 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pillar:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .p-tag {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  .pillar h3 {
    font-family: var(--display);
    font-size: 18.5px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .pillar p {
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--txt-2);
    flex: 1;
  }

  .p-cmd {
    align-self: flex-start;
    margin-top: 6px;
    padding: 5px 10px;
    border-radius: var(--r-sm);
    border: 1px solid var(--bdr);
    background: var(--code-bg);
    font-size: 11.5px;
    color: var(--txt-2);
  }

  @media (max-width: 980px) {
    .store-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .pillars { grid-template-columns: minmax(0, 1fr); margin-top: 44px; }
  }
</style>
