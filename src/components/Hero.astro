---
import { DOCS, GITHUB, INSTALL_CMD } from '../data/links';

const facts = [
  'macOS &amp; Linux',
  'MIT licensed',
];
---

<section class="hero">
  <div class="container hero-inner">
    <span class="pill">
      <span class="dot" aria-hidden="true"></span>
      local-first &middot; open source
    </span>

    <h1>
      An agent that works the way<br />
      <span class="grad">you work.</span>
    </h1>

    <p class="hero-sub">
      px0 is a local, open-source agent built around the way you work. Tell it a chore
      in plain English and it writes, schedules, and runs the workflow itself, wired to 1,000+ apps you already use.
      <em> No server. No dashboard. Nothing hosted.</em>
    </p>

    <div class="install" data-copy={INSTALL_CMD} role="button" tabindex="0" aria-label="Copy install command">
      <span class="install-prompt">$</span>
      <code class="install-cmd">{INSTALL_CMD}</code>
      <span class="install-copy">
        <svg class="i-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg class="i-done" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </span>
    </div>

    <div class="hero-cta">
      <a class="btn btn-primary" href="#workflows">
        See it build a workflow
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a class="btn btn-ghost" href={DOCS} target="_blank" rel="noopener noreferrer">Read the docs</a>
      <a class="btn btn-quiet" href={GITHUB} target="_blank" rel="noopener noreferrer">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        Star on GitHub
      </a>
    </div>

    <ul class="facts">
      {facts.map((f) => <li set:html={f}></li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    padding: 156px 0 96px;
  }

  .hero-inner {
    max-width: 980px;
  }

  h1 {
    font-family: var(--display);
    font-size: clamp(52px, 9vw, 118px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.05em;
    margin: 26px 0 26px;
  }

  .hero-sub {
    font-size: 17px;
    line-height: 1.72;
    color: var(--txt-2);
    max-width: 720px;
  }

  .hero-sub em {
    font-style: normal;
    color: var(--txt);
    font-weight: 600;
  }

  /* ── install line ── */
  .install {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 34px 0 22px;
    padding: 14px 16px;
    max-width: 640px;
    width: 100%;
    border: 1px solid var(--bdr);
    border-radius: var(--r);
    background: var(--code-bg);
    font-family: var(--mono);
    font-size: 13px;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }

  .install:hover,
  .install:focus-visible {
    border-color: var(--amber-line);
    background: var(--amber-wash);
    outline: none;
  }

  .install-prompt {
    color: var(--amber);
    flex-shrink: 0;
  }

  .install-cmd {
    flex: 1;
    min-width: 0;
    color: var(--txt);
    font-size: 13px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .install-copy {
    display: inline-flex;
    color: var(--txt-3);
    flex-shrink: 0;
  }

  .install .i-done { display: none; }
  .install.copied .i-copy { display: none; }
  .install.copied .i-done { display: block; color: var(--green); }

  .hero-cta {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    list-style: none;
    margin-top: 24px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--txt-3);
  }

  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .facts li:not(:first-child)::before {
    content: '';
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--txt-4);
  }

  @media (max-width: 640px) {
    .hero { padding: 116px 0 64px; }
  }
</style>
