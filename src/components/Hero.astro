<script>
  type Sym = { name: string; kind: string; line: number };
  type IdeData = {
    files: string[];
    symbols: Sym[];
    commands: string[];
    file: string;
    lines: number;
    cmd: string;
    boot: string[];
    indexed: string[];
    indexMs: number;
  };
  type Entry = { html: string; say: string; path?: string };

  const stage = document.getElementById('stage');
  const root = document.getElementById('ide');
  const dataEl = document.getElementById('ide-data');

  if (stage && root && dataEl) {
    const data = JSON.parse(dataEl.textContent || '{}') as IdeData;
    const frame = stage.querySelector<HTMLElement>('.stage-frame')!;
    const bootOut = stage.querySelector<HTMLElement>('.boot-out')!;
    const replayBtn = stage.querySelector<HTMLButtonElement>('[data-replay]')!;

    const setPhase = (p: 'boot' | 'ide') => (stage.dataset.phase = p);
    const setView = (v: 'empty' | 'open') => (root.dataset.view = v);

    // ── fuzzyScore, ported line for line from px0's fuzzy.go ──
    const isBoundary = (c: string) => '/_-. @'.includes(c);
    const fuzzyScore = (q: string, path: string) => {
      const lp = path.toLowerCase();
      const nameStart = path.lastIndexOf('/') + 1;
      let qi = 0;
      let end = -1;
      for (let i = 0; i < lp.length && qi < q.length; i++) {
        if (lp[i] === q[qi]) {
          qi++;
          end = i;
        }
      }
      if (qi < q.length) return null;

      const pos: number[] = [];
      qi = q.length - 1;
      for (let i = end; i >= 0 && qi >= 0; i--) {
        if (lp[i] === q[qi]) {
          pos.push(i);
          qi--;
        }
      }
      pos.reverse();

      let score = 0;
      let prev = -2;
      pos.forEach((i, k) => {
        if (i === prev + 1) score += 12;
        else if (k > 0) score -= Math.min(i - prev, 12);
        if (i >= nameStart) score += 14;
        if (i === 0 || isBoundary(path[i - 1])) score += 16;
        else if (/[A-Z]/.test(path[i]) && /[a-z]/.test(path[i - 1])) score += 14;
        if (path[i] === q[k]) score += 4;
        prev = i;
      });
      score -= Math.floor(path.length / 8);
      score -= (path.split('/').length - 1) * 2;
      const idx = lp.slice(nameStart).indexOf(q);
      if (idx >= 0) {
        score += 40;
        if (idx === 0) score += 20;
      }
      return { score, pos };
    };

    // ── palette ──
    const pal = root.querySelector<HTMLElement>('.ide-pal')!;
    const input = pal.querySelector<HTMLInputElement>('input')!;
    const list = pal.querySelector<HTMLElement>('.ide-pal-list')!;
    const modeEl = pal.querySelector<HTMLElement>('.ide-pal-mode')!;
    const metaEl = pal.querySelector<HTMLElement>('.ide-pal-meta')!;
    const toastEl = root.querySelector<HTMLElement>('.ide-toast')!;
    let entries: Entry[] = [];
    let active = 0;

    const esc = (s: string) =>
      s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] || c);
    const mark = (s: string, pos: number[], offset = 0) => {
      const hits = new Set(pos);
      let out = '';
      for (let i = 0; i < s.length; i++) out += hits.has(i + offset) ? `<b>${esc(s[i])}</b>` : esc(s[i]);
      return out;
    };
    const rank = (items: string[], q: string) => {
      if (!q) return { total: items.length, top: items.slice(0, 8).map((item) => ({ item, pos: [] as number[], score: 0 })) };
      const out: { item: string; pos: number[]; score: number }[] = [];
      for (const item of items) {
        const m = fuzzyScore(q, item);
        if (m) out.push({ item, ...m });
      }
      out.sort((a, b) => b.score - a.score || a.item.localeCompare(b.item));
      return { total: out.length, top: out.slice(0, 8) };
    };

    const render = () => {
      const raw = input.value;
      const q = raw.replace(/^[>@:]/, '').toLowerCase().replace(/\s+/g, '');
      const t0 = performance.now();
      let mode = 'files';
      let total = 0;

      if (raw.startsWith('>')) {
        mode = 'command';
        const r = rank(data.commands, q);
        total = r.total;
        entries = r.top.map(({ item, pos, score }) => ({
          html: `<span class="n">${mark(item, pos)}</span>${q ? `<span class="sc">${score}</span>` : ''}`,
          say: `ran: ${item}`,
        }));
      } else if (raw.startsWith('@')) {
        mode = 'symbol';
        const r = rank(data.symbols.map((s) => s.name), q);
        total = r.total;
        entries = r.top.map(({ item, pos, score }) => {
          const s = data.symbols.find((x) => x.name === item)!;
          return {
            html: `<span class="kd">${s.kind}</span><span class="n">${mark(item, pos)}</span><span class="d">${data.file}:${s.line}</span>${q ? `<span class="sc">${score}</span>` : ''}`,
            say: `jumped to ${item}, line ${s.line}`,
          };
        });
      } else if (raw.startsWith(':')) {
        mode = 'line';
        const n = parseInt(raw.slice(1), 10);
        const ok = Number.isFinite(n);
        total = 1;
        entries = [{
          html: `<span class="n">Go to line <b>${ok ? n : '_'}</b></span><span class="d">${data.file} · ${data.lines} lines</span>`,
          say: ok ? `line ${Math.min(Math.max(n, 1), data.lines)}` : 'type a line number',
        }];
      } else {
        const r = rank(data.files, q);
        total = r.total;
        entries = r.top.map(({ item, pos, score }) => {
          const cut = item.lastIndexOf('/') + 1;
          return {
            html: `<span class="n">${mark(item.slice(cut), pos, cut)}</span><span class="d">${mark(item.slice(0, cut), pos)}</span>${q ? `<span class="sc">${score}</span>` : ''}`,
            say: `opened ${item}`,
            path: item,
          };
        });
      }

      const ms = performance.now() - t0;
      modeEl.textContent = mode;
      list.innerHTML = entries.length
        ? entries.map((e) => `<div class="pal-row" role="option">${e.html}</div>`).join('')
        : '<div class="pal-empty">no matches</div>';
      metaEl.textContent = `${total} ranked · ${ms < 0.1 ? '<0.1' : ms.toFixed(1)} ms`;
      setActive(0);
    };

    const setActive = (i: number) => {
      const rows = list.querySelectorAll('.pal-row');
      if (!rows.length) return;
      active = (i + rows.length) % rows.length;
      rows.forEach((r, j) => r.classList.toggle('on', j === active));
    };

    let toastTimer = 0;
    const toast = (msg: string) => {
      toastEl.textContent = msg;
      toastEl.hidden = false;
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => (toastEl.hidden = true), 1600);
    };

    const openPal = (focus: boolean) => {
      pal.hidden = false;
      render();
      if (focus) input.focus({ preventScroll: true });
    };
    const closePal = () => {
      pal.hidden = true;
      input.value = '';
    };
    const choose = () => {
      const e = entries[active];
      if (e?.path === data.file) setView('open');
      if (e) toast(e.say);
      closePal();
    };

    input.addEventListener('input', render);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter') { e.preventDefault(); choose(); }
      else if (e.key === 'Escape') { e.preventDefault(); closePal(); }
    });
    list.addEventListener('pointermove', (e) => {
      const row = (e.target as HTMLElement).closest('.pal-row');
      if (row) setActive([...list.children].indexOf(row));
    });
    list.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.pal-row')) choose();
    });

    // ── scripted demo: boot from a terminal, then drive the palette, until the visitor takes over ──
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let run = 0; // bumped to cancel whatever script is in flight
    let visible = false;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const live = async (id: number) => {
      while (id === run && !visible) await sleep(300);
      return id === run;
    };

    // Jump straight to the finished scene: IDE up, lib/sort.c open.
    const finish = () => {
      run++;
      closePal();
      setView('open');
      setPhase('ide');
      replayBtn.hidden = reduce;
    };

    frame.addEventListener('pointerdown', (e) => {
      if (stage.dataset.phase === 'boot') {
        finish();
        return;
      }
      run++;
      const t = e.target as HTMLElement;
      if (!t.closest('.ide-pal') && !t.closest('[data-pal-open]')) closePal();
    });
    input.addEventListener('focus', () => run++);
    root.querySelectorAll('[data-pal-open]').forEach((b) =>
      b.addEventListener('click', () => {
        run++;
        input.value = '';
        openPal(true);
      })
    );

    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.3 }).observe(frame);

    const PROMPT = '<span class="s-warn">$</span> ';
    const CARET = '<span class="caret"></span>';

    const boot = async (id: number) => {
      closePal();
      setView('empty');
      setPhase('boot');
      replayBtn.hidden = true;
      bootOut.innerHTML = PROMPT + CARET;

      if (!(await live(id))) return false;
      await sleep(700);
      let typed = '';
      for (const ch of data.cmd) {
        if (!(await live(id))) return false;
        typed += ch;
        bootOut.innerHTML = PROMPT + esc(typed) + CARET;
        await sleep(50 + Math.random() * 60);
      }
      await sleep(420);
      if (id !== run) return false;

      // Enter: the header prints at once, the index lands a moment later, the browser is already up.
      let text = PROMPT + esc(data.cmd) + '\n' + data.boot.join('\n');
      bootOut.innerHTML = `${text}\n${CARET}`;
      await sleep(data.indexMs);
      if (id !== run) return false;
      text += '\n' + data.indexed.join('\n');
      bootOut.innerHTML = `${text}\n${CARET}`;
      await sleep(520);
      if (id !== run) return false;

      setPhase('ide');
      replayBtn.hidden = false;
      return true;
    };

    const typeInto = async (id: number, text: string) => {
      input.value = '';
      render();
      for (const ch of text) {
        if (!(await live(id))) return false;
        input.value += ch;
        render();
        await sleep(90 + Math.random() * 70);
      }
      return id === run;
    };

    const script: [string, number, number][] = [
      ['schedcore', 1500, 0],
      ['ext4inode', 1400, 1],
      ['@swap', 1300, 1],
      ['>diff', 1200, 0],
      [':253', 1000, 0],
    ];

    const tour = async (id: number) => {
      // First find: open lib/sort.c out of the freshly indexed tree.
      await sleep(900);
      if (!(await live(id))) return;
      openPal(false);
      if (!(await typeInto(id, 'libsort'))) return;
      await sleep(650);
      const at = entries.findIndex((e) => e.path === data.file);
      if (at > 0) setActive(at);
      await sleep(350);
      if (id !== run) return;
      choose();
      await sleep(2600);

      while (await live(id)) {
        openPal(false);
        for (const [q, hold, moves] of script) {
          if (!(await typeInto(id, q))) return;
          await sleep(450);
          for (let i = 0; i < moves && id === run; i++) {
            setActive(active + 1);
            await sleep(280);
          }
          await sleep(hold);
          if (id !== run) return;
        }
        closePal();
        await sleep(2400);
      }
    };

    const play = async () => {
      const id = ++run;
      if (await boot(id)) tour(id);
    };

    replayBtn.addEventListener('click', play);

    if (reduce) finish();
    else play();
  }
</script>
