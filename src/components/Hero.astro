---
import { GITHUB, INSTALL_CMD, VERSION } from '../data/links';
import { THEMES } from '../data/themes';
import { COMMANDS, CORPUS } from '../data/px0';
import { KERNEL_FILES, ROOT_DIRS, ROOT_FILES, LIB_WINDOW, SORT_SYMBOLS, DO_SWAP_REFS, SORT_EXCERPT } from '../data/kernel';
import { getLatestChangelog } from '../data/changelogs';

const latestRelease = getLatestChangelog();
const latestVersion = latestRelease?.version || VERSION;

const stats = [
  { v: '<1', u: 'ms', k: 'cold start', d: 'sub-millisecond instant boot' },
  { v: '20', u: 'MB', k: 'resident memory', d: 'VS Code on the same tree: ~1,440 MB', hi: true },
  { v: '6.0', u: 'ms', k: 'fuzzy find', d: 'linux kernel, 95,710 files' },
  { v: '~280', u: '', k: 'languages', d: 'tokenized natively by Chroma' },
  { v: '14', u: '', k: 'themes', d: 'one CSS file each' },
  { v: '0', u: '', k: 'runtime deps', d: 'no Electron, no Node, no CGO' },
];

// The linux row of BENCHMARKS.md drives every number the mock shows.
const linux = CORPUS.find((r) => r.repo === 'linux')!;
const fileCount = linux.files.toLocaleString('en-US');

// A small C tokenizer, enough to colour the excerpt with the IDE's own token classes.
const C_KW = new Set('break case const continue default do else enum extern for goto if inline register return sizeof static struct switch typedef union volatile while'.split(' '));
const C_TYPES = new Set('bool char double float int long short signed unsigned void size_t'.split(' '));
const C_CONST = new Set(['NULL', 'true', 'false']);

type Tok = { c: string; v: string };
function tokenizeC(line: string, open: boolean): { toks: Tok[]; open: boolean } {
  const out: Tok[] = [];
  let at = 0;
  if (open) {
    const end = line.indexOf('*/');
    if (end < 0) return { toks: [{ c: 'c', v: line }], open: true };
    at = end + 2;
    out.push({ c: 'c', v: line.slice(0, at) });
    open = false;
  }
  const re = /(\/\*(?:.*?\*\/|.*$))|(\/\/.*$)|("(?:[^"\\]|\\.)*")|('(?:[^'\\]|\\.)*')|(\b\d+\b)|([A-Za-z_]\w*)|([-+*/%=!<>&|^~?:]+)|([()[\]{}.,;])/g;
  re.lastIndex = at;
  let m: RegExpExecArray | null;
  while ((m = re.exec(line))) {
    if (m.index > at) out.push({ c: '', v: line.slice(at, m.index) });
    at = re.lastIndex;
    const v = m[0];
    if (m[1]) {
      out.push({ c: 'c', v });
      if (!v.slice(2).endsWith('*/')) open = true;
    } else if (m[2]) out.push({ c: 'c', v });
    else if (m[3] || m[4]) out.push({ c: 's', v });
    else if (m[5]) out.push({ c: 'm', v });
    else if (m[6]) {
      let c = 'nv';
      if (C_KW.has(v)) c = 'k';
      else if (C_TYPES.has(v)) c = 'kt';
      else if (C_CONST.has(v)) c = 'no';
      else if (line[at] === '(') c = 'nf';
      if (v === 'do_swap') c += ' occ';
      out.push({ c, v });
    } else if (m[7]) out.push({ c: 'o', v });
    else out.push({ c: 'p', v });
  }
  if (at < line.length) out.push({ c: '', v: line.slice(at) });
  return { toks: out, open };
}

const CURSOR_LINE = 236;
let inComment = false;
const rows = SORT_EXCERPT.lines.map((text, i) => {
  const n = SORT_EXCERPT.start + i;
  const r = tokenizeC(text, inComment);
  inComment = r.open;
  if (n === CURSOR_LINE) {
    const at = r.toks.findIndex((t) => t.v === 'do_swap');
    if (at >= 0) r.toks.splice(at + 1, 0, { c: 'caret', v: '' });
  }
  return { n, toks: r.toks, cur: n === CURSOR_LINE };
});
const hoverRow = CURSOR_LINE - SORT_EXCERPT.start;
const pct = (line: number) => `${(line / SORT_EXCERPT.total) * 100}%`;

const ext = (name: string) => (name.includes('.') ? name.split('.').pop() || '' : '').toLowerCase();
const [refDef, ...refUses] = DO_SWAP_REFS;

const themeStyle = (vars: Record<string, string>) =>
  Object.entries(vars).map(([k, v]) => `--t-${k}:${v}`).join(';');

// What px0 prints on start, laid out by uiHeading, uiKV (width 11), uiHint, uiStatus and uiBullet.
const bootLines = [
  '',
  `<b class="t-strong">px0 ${VERSION}</b>`,
  `  <span class="s-dim">workspace:</span>  /home/you/workspace/kernel`,
  `  <span class="s-dim">url:</span>        <span class="t-accent">http://127.0.0.1:7777</span>`,
  '',
  '<span class="s-dim">ctrl-c to stop</span>',
];
const indexLines = [
  `<span class="s-ok">✓</span> indexed ${linux.files} files  <span class="s-dim">${linux.index}ms</span>`,
  '  <span class="t-faint">·</span> language servers: clangd (started on first use)',
];

const ideData = {
  files: KERNEL_FILES,
  symbols: SORT_SYMBOLS,
  commands: COMMANDS.filter((c) => !c.includes('Theme')),
  file: SORT_EXCERPT.file,
  lines: SORT_EXCERPT.total,
  cmd: 'px0 ~/workspace/kernel',
  boot: bootLines,
  indexed: indexLines,
  indexMs: linux.index,
};
---

<section class="hero">
  <div class="wrap">
    <div class="hero-announcement">
      <a href="/changelog" class="pill announcement-pill">
        <span class="dot" aria-hidden="true"></span>
        <span class="announcement-text">new version v{latestVersion} is out</span>
        <span class="announcement-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="hero-meta">
      <span><b>px0</b> v{VERSION}</span>
      <span>optimized for read</span>
      <span>open source</span>
    </div>

    <div class="hero-grid">
      <div class="hero-copy">
        <p class="kicker"><span>//</span> when all you want is speed.</p>
        <h1>Just. Damn.<br /><span class="hl">Fast.</span><i class="h1-cur" aria-hidden="true"></i></h1>
        <p class="hero-sub">
          px0 is a fast, ultra-light, remote-first IDE designed for instant code navigation and review in your browser.
          It starts in <strong>under 1 ms</strong>, idles at <strong>~20 MB</strong>, and fuzzy-finds across the
          Linux kernel's <strong>95,710 files in 6 ms</strong>. When something needs to change, hand it to your coding agent: px0 runs it and reloads what moved.
        </p>

        <div class="hero-actions">
          <button class="copyline" type="button" data-copy={INSTALL_CMD} aria-label="Copy install command">
            <span class="copyline-p">$</span>
            <code><span>{INSTALL_CMD}</span></code>
            <span class="copyline-s"></span>
          </button>
          <div class="hero-cta">
            <a class="btn btn-primary" href={GITHUB} target="_blank" rel="noopener noreferrer">
              Star on GitHub
            </a>
            <a class="btn btn-ghost" href="#bench">See the benchmarks ↓</a>
          </div>

          <div class="hero-harnesses">
            <span class="hh-label">Supported harnesses:</span>
            <div class="hh-pills">
              <span class="hh-pill"><i class="hh-dot"></i>Claude Code</span>
              <span class="hh-pill"><i class="hh-dot"></i>Gemini CLI</span>
              <span class="hh-pill"><i class="hh-dot"></i>Cursor Agent</span>
              <span class="hh-pill"><i class="hh-dot"></i>Antigravity</span>
              <span class="hh-pill"><i class="hh-dot"></i>OpenCode</span>
              <span class="hh-pill"><i class="hh-dot"></i>OpenAI Codex</span>
              <span class="hh-pill"><i class="hh-dot"></i>Aider</span>
              <span class="hh-pill"><i class="hh-dot"></i>Goose</span>
            </div>
          </div>
        </div>
      </div>

      <dl class="hero-stats">
        {stats.map((s) => (
          <div class:list={['stat', { 'stat--hi': s.hi }]}>
            <dt class="stat-k">{s.k}</dt>
            <dd class="stat-v">{s.v}{s.u && <small>{s.u}</small>}</dd>
            <dd class="stat-d">{s.d}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="stage" id="stage" data-phase="boot">
      <div class="stage-bar">
        <span class="lbl">~/workspace/kernel · {fileCount} files</span>
        <button class="stage-replay" type="button" data-replay hidden>↻ replay</button>
      </div>

      <div class="stage-frame">
        <div class="ide" id="ide" data-view="open" style={themeStyle(THEMES[0].vars)}>
          <div class="ide-chrome">
            <span class="ide-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="ide-url">127.0.0.1:7777</span>
            <button class="ide-k" type="button" data-pal-open aria-label="Open palette"><span class="mod-key">Ctrl</span> K</button>
          </div>

          <div class="ide-body">
            <aside class="ide-side" aria-hidden="true">
              <header class="ide-phead"><span>kernel</span><span class="tree-acts"><span class="git-filter-btn">filter</span><span>↻</span></span></header>
              <ul class="ide-tree v-empty">
                {ROOT_DIRS.map((name) => (
                  <li class="dir"><span class="chev">▸</span><span class="tree-name">{name}</span></li>
                ))}
                {ROOT_FILES.map((name) => (
                  <li><span class="chev"></span><i class={`fi x-${ext(name)}`}></i><span class="tree-name">{name}</span></li>
                ))}
              </ul>
              <ul class="ide-tree v-open">
                {LIB_WINDOW.map((entry) => {
                  const dir = entry.endsWith('/');
                  const name = dir ? entry.slice(0, -1) : entry;
                  return (
                    <li class:list={['in', { dir, on: name === 'sort.c' }]}>
                      <span class="chev">{dir ? '▸' : ''}</span>
                      {!dir && <i class={`fi x-${ext(name)}`}></i>}
                      <span class="tree-name">{name}</span>
                    </li>
                  );
                })}
              </ul>
            </aside>

            <div class="ide-main">
              <div class="ide-tabs" aria-hidden="true">
                <span class="ide-tab on v-open">sort.c <span class="x">×</span></span>
                <div class="tab-acts v-open"><span class="diff-btn">Diff</span></div>
              </div>
              <div class="ide-crumbs" aria-hidden="true">
                kernel<span class="v-open crumbs-rest"> <span>›</span> lib <span>›</span> sort.c <span>›</span> <b>__sort_r</b></span>
              </div>

              <div class="ide-editor">
                <div class="ide-empty v-empty" aria-hidden="true">
                  <div class="emp-title">kernel</div>
                  <div class="emp-sub"><i class="ok"></i>{fileCount} files indexed in {linux.index} ms</div>
                  <dl class="emp-keys">
                    <div><dt>Go to file</dt><dd><kbd><span class="mod-key">Ctrl</span> P</kbd></dd></div>
                    <div><dt>Search in files</dt><dd><kbd><span class="mod-key">Ctrl</span> <span class="shift-key">Shift</span> F</kbd></dd></div>
                    <div><dt>Palette</dt><dd><kbd><span class="mod-key">Ctrl</span> K</kbd></dd></div>
                  </dl>
                </div>

                <div class="ide-code v-open" aria-label={`${SORT_EXCERPT.file}, lines ${SORT_EXCERPT.start} to ${SORT_EXCERPT.start + SORT_EXCERPT.lines.length - 1}`}>
                  {rows.map((r) => (
                    <div class:list={['row', { cur: r.cur }]}>
                      <span class="ln">{r.n}</span>
                      <span class="tx">{r.toks.map((t) => (t.c === 'caret' ? <i class="ide-caret"></i> : <span class={t.c || undefined}>{t.v}</span>))}</span>
                    </div>
                  ))}
                </div>

                <div class="ide-hover v-open" style={`--row:${hoverRow}`} aria-hidden="true">
                  <div class="hv-sig"><span class="k">static</span> <span class="kt">void</span> <span class="nf">do_swap</span><span class="p">(</span><span class="kt">void</span> <span class="o">*</span>a<span class="p">,</span> <span class="kt">void</span> <span class="o">*</span>b<span class="p">,</span> <span class="kt">size_t</span> size<span class="p">,</span>{'\n'}                    swap_r_func_t swap_func<span class="p">,</span> <span class="k">const</span> <span class="kt">void</span> <span class="o">*</span>priv<span class="p">)</span></div>
                  <div class="hv-meta">{SORT_EXCERPT.file}:{refDef.line} · clangd</div>
                  <div class="hv-act"><span><kbd>F12</kbd> definition</span><span><kbd>Shift F12</kbd> references</span></div>
                </div>

                <div class="ide-scroll v-open" aria-hidden="true">
                  <span class="thumb" style={`top:${pct(SORT_EXCERPT.start)};height:${pct(SORT_EXCERPT.lines.length)}`}></span>
                  {DO_SWAP_REFS.map((r) => <span class="hit" style={`top:${pct(r.line)}`}></span>)}
                </div>

                <div class="ide-pal" hidden>
                  <div class="ide-pal-in">
                    <span class="ide-pal-mode">files</span>
                    <input type="text" spellcheck="false" autocomplete="off" aria-label="Palette query" placeholder="path, or > command, @ symbol, : line" />
                  </div>
                  <div class="ide-pal-list" role="listbox"></div>
                  <div class="ide-pal-hint"><span>↑↓ move</span><span>enter open</span><span>esc close</span><span class="ide-pal-meta"></span></div>
                </div>

                <div class="ide-toast" hidden></div>
              </div>

              <footer class="ide-status">
                <button class="st" type="button" data-pal-open>Files <kbd><span class="mod-key">Ctrl</span> P</kbd></button>
                <span class="st opt">Search <kbd><span class="mod-key">Ctrl</span> <span class="shift-key">Shift</span> F</kbd></span>
                <span class="st opt">Diff <kbd><span class="mod-key">Ctrl</span> D</kbd></span>
                <span class="st grow"></span>
                <span class="st opt v-open"><i class="lsp"></i>Agent: agy (gemini-3.6-flash-low)</span>
                <span class="st opt v-open">{SORT_EXCERPT.total} lines</span>
                <span class="st"><i class="lsp"></i>clangd</span>
                <span class="st">CPU 0.0% · RAM {linux.mem} MB</span>
              </footer>
            </div>

            <aside class="ide-insp" aria-hidden="true">
              <div class="insp-tabs"><span class="insp-tab on">References</span><span class="insp-tab">Symbols</span></div>
              <div class="insp-empty v-empty">No file open.<br />Open one to see references and its outline.</div>
              <div class="v-open">
                <div class="insp-bar"><b>do_swap</b><span class="badge">{DO_SWAP_REFS.length}</span></div>
                <div class="ref-file">{SORT_EXCERPT.file}</div>
                <div class="ref"><span class="l">{refDef.line}</span><span class="t">{refDef.text}</span><span class="tag">def</span></div>
                {refUses.map((r) => (
                  <div class:list={['ref', { on: r.line === CURSOR_LINE }]}><span class="l">{r.line}</span><span class="t">{r.text}</span></div>
                ))}
                <div class="insp-sec">outline · sort.c</div>
                {SORT_SYMBOLS.map((s) => (
                  <div class:list={['sym', { on: s.name === '__sort_r' }]}><span class="kd">{s.kind}</span><span class="nm">{s.name}</span><span class="l">{s.line}</span></div>
                ))}
              </div>
            </aside>
          </div>
        </div>

        <div class="boot" aria-hidden="true">
          <div class="term boot-term">
            <div class="term-bar">
              <span class="term-dots"><i></i><i></i><i></i></span>
              <span class="term-title">~ · zsh</span>
            </div>
            <div class="term-body"><pre class="boot-out"><span class="s-warn">$</span> <span class="caret"></span></pre></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <noscript><style is:inline>
    .stage[data-phase] .boot { display: none !important; }
    .stage[data-phase] .ide { opacity: 1 !important; transform: none !important; pointer-events: auto !important; }
  </style></noscript>

  <script type="application/json" id="ide-data" is:inline set:html={JSON.stringify(ideData)}></script>
</section>

<style>
  .hero {
    padding-top: 80px;
  }

  /* ── announcement pill ── */
  .hero-announcement {
    display: flex;
    margin-bottom: 16px;
  }

  .announcement-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 12px;
    border: 1px solid var(--bdr-hi);
    background: var(--surface);
    font-size: 11.5px;
    color: var(--txt-2);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s, color 0.15s, transform 0.15s;
  }

  .announcement-pill:hover {
    border-color: var(--amber-line);
    background: var(--amber-wash);
    color: var(--txt);
    transform: translateY(-1px);
  }

  .announcement-text {
    color: var(--txt);
  }

  .announcement-arrow {
    color: var(--amber);
    transition: transform 0.15s;
  }

  .announcement-pill:hover .announcement-arrow {
    transform: translateX(2px);
  }

  /* ── meta strip ── */
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--bdr);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--txt-3);
  }

  .hero-meta span {
    padding: 7px 12px;
    border-right: 1px solid var(--bdr);
    white-space: nowrap;
  }

  .hero-meta b {
    color: var(--amber);
    font-weight: 600;
  }

  /* ── copy + stats ── */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    border: 1px solid var(--bdr);
    border-top: 0;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
  }

  .hero-copy {
    padding: 44px 40px 40px;
    border-right: 1px solid var(--bdr);
  }

  .kicker {
    font-size: 12px;
    color: var(--txt-3);
  }

  .kicker span {
    color: var(--amber);
  }

  h1 {
    margin: 18px 0 24px;
    font-size: clamp(42px, 6.6vw, 92px);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.06em;
  }

  h1 .hl {
    color: var(--amber);
  }

  .h1-cur {
    display: inline-block;
    width: 0.5em;
    height: 0.78em;
    margin-left: 0.06em;
    background: var(--amber);
    vertical-align: -0.04em;
    animation: blink 1.05s step-end infinite;
  }

  .hero-sub {
    max-width: 620px;
    font-size: 14px;
    line-height: 1.75;
    color: var(--txt-2);
  }

  .hero-sub strong {
    color: var(--txt);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 660px;
    margin-top: 28px;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-harnesses {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-top: 4px;
    font-size: 11px;
    color: var(--txt-muted);
  }

  .hh-label {
    letter-spacing: 0.04em;
    color: var(--txt-dim);
  }

  .hh-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .hh-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 7px;
    border-radius: 2px;
    border: 1px solid var(--bdr);
    background: var(--bg-card);
    color: var(--txt);
    font-size: 11px;
    font-family: var(--font-mono);
  }

  .hh-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--amber);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stat {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding: 20px 22px;
    border-right: 1px solid var(--bdr);
    border-bottom: 1px solid var(--bdr);
  }

  .stat:nth-child(2n) { border-right: 0; }
  .stat:nth-last-child(-n + 2) { border-bottom: 0; }

  .stat-k {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--txt-3);
  }

  .stat-v {
    font-size: clamp(30px, 3.2vw, 46px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--txt);
  }

  .stat-v small {
    margin-left: 0.15em;
    font-size: 0.4em;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--txt-3);
  }

  .stat--hi .stat-v {
    color: var(--amber);
  }

  .stat-d {
    font-size: 11.5px;
    color: var(--txt-3);
  }

  /* ── stage ── */
  .stage {
    margin-top: 28px;
  }

  .stage-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    min-height: 32px;
    padding-bottom: 10px;
  }

  .stage-replay {
    height: 22px;
    padding: 0 8px;
    border: 1px solid var(--bdr);
    background: none;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--txt-3);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .stage-replay:hover {
    border-color: var(--amber-line);
    color: var(--amber);
  }

  .stage-frame {
    position: relative;
  }

  /* ── boot: the terminal that launches px0 ── */
  .boot {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    border: 1px solid var(--bdr);
    background-color: var(--bg-elev);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 32px 32px;
    transition: opacity 0.2s ease-out, visibility 0s linear 0.2s;
  }

  .boot-term {
    width: min(680px, 100%);
  }

  .boot-out {
    min-height: calc(10 * 1.75em);
    color: var(--txt);
  }

