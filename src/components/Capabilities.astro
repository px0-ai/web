---
import { COMPOSIO } from '../data/links';

const apps = [
  'GitHub', 'Slack', 'Gmail', 'Google Calendar', 'Notion', 'Linear', 'Jira',
  'Google Sheets', 'Stripe', 'Zendesk', 'Sentry', 'Salesforce', 'HubSpot',
  'Asana', 'Airtable', 'Discord', 'Trello', 'Dropbox', 'Figma', 'PagerDuty',
];

const harnesses = ['claude', 'gemini', 'pi', 'opencode'];

const small = [
  {
    tag: 'guidelines',
    title: 'Guidelines you never write from scratch',
    body: 'When a build leans on a convention you have not written down (a commit format, a review rubric), px0 drafts the guideline from the workflow itself and shows it to you before saving. Reword it once and every run inlines your version, verbatim.',
    accent: 'var(--violet)',
  },
  {
    tag: 'px0 approvals',
    title: 'Draft it and ask me',
    body: 'Mark a workflow confirm: true and anything that would post, send, or file gets written down instead of fired. The run still finishes and still produces its output. You see the exact arguments next to the digest they announce, then approve, edit the channel, or throw it away. Approving sends what you read, not a fresh run against a later hour.',
    accent: 'var(--amber)',
  },
  {
    tag: 'px0 memory',
    title: 'Tell it once',
    body: 'That standup goes out before 09:30. That the API repo means acme/api. One Markdown file per fact, versioned like everything else, inlined into every run inside a budget. You will rarely type one: when you mark a run bad or correct px0 in a conversation, it reads what you said for the part still true next month and offers to keep it.',
    accent: 'var(--violet)',
  },
  {
    tag: 'px0 workflows health',
    title: 'It reads its own runs',
    body: 'Arithmetic over your run records, no model call: the tool nothing has called and every prompt still pays for, the input that has resolved empty for a month, the runs that succeeded and produced nothing. Two of those px0 repairs itself. For the rest it proposes a revision and shows it as a diff against the sentence you wrote.',
    accent: 'var(--green)',
  },
  {
    tag: 'px0 mcp serve',
    title: 'Speaks MCP, not just CLI',
    body: 'Point Claude Code, or any MCP client, at px0 and it can ask your brain a question, list your workflows, and run one, all over stdio with no SDK involved. Running a workflow stays off until you pass --allow-runs.',
    accent: 'var(--cyan)',
  },
  {
    tag: 'retrieval',
    title: 'Keyword by default, semantic when you want it',
    body: 'SQLite FTS5 with BM25 ships built in, nothing to install. Switch the backend to qmd for hybrid vector search with reranking. It prints the model download size and waits for a yes.',
    accent: 'var(--green)',
  },
];
---

<section class="section" id="capabilities">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">what else is in the box</span>
      <h2 class="h-section">Small surface. Long reach.</h2>
      <p class="sub">
        One CLI, one directory, one API key for the outside world, and everything else is
        already on your machine.
      </p>
    </div>

    <div class="bento">
      <article class="b-card b-wide reveal">
        <header>
          <span class="b-tag" style="--accent: var(--amber)">connections</span>
          <h3>Reaches the apps you already live in</h3>
        </header>
        <p>
          Tools route through <a href={COMPOSIO} target="_blank" rel="noopener noreferrer">Composio</a>,
          so there is exactly one key to set up and no per-app connect command to hunt for. Apps
          authorize themselves: the first time a workflow needs Gmail, px0 prepares Gmail’s
          authorization and hands you the URL. You never connect a service you turn out not to need.
        </p>
        <div class="app-cloud" aria-hidden="true">
          {apps.map((a) => <span class="chip">{a}</span>)}
          <span class="chip chip-more">+1,000 more</span>
        </div>
      </article>

      <article class="b-card reveal">
        <header>
          <span class="b-tag" style="--accent: var(--cyan)">model backend</span>
          <h3>Runs on the agent CLI you already sign into</h3>
        </header>
        <p>
          px0 shells out to a coding agent CLI in non-interactive mode, reusing its login, its
          model choice, and its rate limits. There is no separate API key to add and no bill to
          split.
        </p>
        <div class="harness-list">
          {harnesses.map((h) => (
            <span class="harness">
              <span class="h-dot"></span>{h}
            </span>
          ))}
        </div>
        <code class="b-cmd">px0 config model</code>
        <p class="b-foot">
          It invokes the backend before saving, so a typo’d model name fails there instead of
          mid-workflow.
        </p>
      </article>

      {small.map((s) => (
        <article class="b-card reveal" style={`--accent:${s.accent}`}>
          <header>
            <span class="b-tag">{s.tag}</span>
            <h3>{s.title}</h3>
          </header>
          <p>{s.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .b-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px 26px 24px;
    border: 1px solid var(--bdr);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: border-color 0.25s, transform 0.25s, background 0.25s;
    --accent: var(--amber);
  }

  .b-card::before {
    content: '';
    position: absolute;
    inset: -40% 40% auto -20%;
    height: 140px;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 22%, transparent), transparent);
    opacity: 0;
    transition: opacity 0.35s;
    pointer-events: none;
  }

  .b-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 34%, transparent);
  }

  .b-card:hover::before { opacity: 1; }

  .b-wide { grid-column: span 2; }

  .b-tag {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .b-card h3 {
    font-family: var(--display);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.28;
  }

  .b-card p {
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--txt-2);
  }

  .b-card p a {
    color: var(--amber);
    border-bottom: 1px solid var(--amber-line);
  }

  .b-card p a:hover { border-bottom-color: currentColor; }

  .app-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 6px;
  }

  .chip-more {
    color: var(--amber);
    border-color: var(--amber-line);
    background: var(--amber-wash);
  }

  .harness-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 4px 0 2px;
  }

  .harness {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border: 1px solid var(--bdr);
    border-radius: var(--r-sm);
    background: var(--code-bg);
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--txt);
  }

  .h-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 10px color-mix(in srgb, var(--cyan) 60%, transparent);
  }

  .b-cmd {
    align-self: flex-start;
    padding: 5px 10px;
    border-radius: var(--r-sm);
    border: 1px solid var(--bdr);
    background: var(--code-bg);
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--txt-2);
  }

  .b-foot {
    font-size: 12px !important;
    color: var(--txt-3) !important;
    line-height: 1.65 !important;
  }

  @media (max-width: 980px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .b-wide { grid-column: span 2; }
  }

  @media (max-width: 620px) {
    .bento { grid-template-columns: minmax(0, 1fr); }
    .b-wide { grid-column: auto; }
  }
</style>
