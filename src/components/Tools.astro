---
const toolFeatures = [
  {
    icon: "{} schema",
    color: "#38bdf8",
    title: "JSON Schema Definitions",
    desc: "Specify precise input parameters and expected output structures using JSON Schema specifications. Guarantee perfect validation and type safety.",
    tag: "input & output schemas",
  },
  {
    icon: "👁 discover",
    color: "#fbbf24",
    title: "Dynamic LLM Discovery",
    desc: "Expose rich, structured metadata for LLM orchestration systems. Allow models to discover, select, and execute tools dynamically based on context.",
    tag: "orchestration ready",
  },
  {
    icon: "↗ pipeline",
    color: "#8b5cf6",
    title: "Promotion Pipelines",
    desc: "Evolve your tool schemas safely through standard promotion flows: draft → stable → live. Prevent breaking active production callers.",
    tag: "draft · stable · live",
  },
  {
    icon: "🔒 frozen",
    color: "#f43f5e",
    title: "Zero-Drift Execution",
    desc: "All active and stable tool schemas are completely immutable. Ensure production agents and model runtimes always execute against frozen definitions.",
    tag: "immutable versions",
  },
  {
    icon: "⌨ console",
    color: "#10b981",
    title: "Dual Control Planes",
    desc: "Manage your tool registry programmatically via clean REST APIs, or visually using the intuitive, developer-friendly px0 Web Console.",
    tag: "api & web console",
  },
  {
    icon: "⎘ rollback",
    color: "#14b8a6",
    title: "Atomic Rollbacks",
    desc: "Promoting a tool version to live automatically demotes any previously active version. Instantly roll back schemas with a single API call.",
    tag: "one-click demotion",
  },
];
---

<section class="features" id="tool-registry">
  <div class="container">
    <p class="section-eyebrow">// manage schema evolution</p>
    <h2 class="section-heading">Tool Registry</h2>
    <div class="feature-grid">
      {toolFeatures.map(f => (
        <div class="feature-card">
          <div class="f-icon" style={`color:${f.color}`}>{f.icon}</div>
          <h3 class="f-title">{f.title}</h3>
          <p class="f-desc">{f.desc}</p>
          <span
            class="f-tag"
            style={`color:${f.color};border-color:${f.color}33;background:${f.color}0f`}
          >{f.tag}</span>
        </div>
      ))}
    </div>
  </div>
</section>
