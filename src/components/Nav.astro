---
import { GITHUB, VERSION } from '../data/links';

const base = Astro.url.pathname === '/' ? '' : '/';
const sections = ['bench', 'why', 'features', 'arch', 'keys', 'cli', 'install'];
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="logo-link" aria-label="px0 home">
      <img src="/logo/px0-logo-dark.png" alt="px0" class="logo-img logo-dark" />
      <img src="/logo/px0-logo-light.png" alt="px0" class="logo-img logo-light" />
    </a>
    <span class="nav-tag">read-only ide</span>

    <div class="nav-mid">
      {sections.map((s, i) => (
        <a class="nav-link" href={`${base}#${s}`}><span>0{i + 1}</span>{s}</a>
      ))}
    </div>

    <div class="nav-right">
      <span class="nav-ver">v{VERSION}</span>

      <button id="theme-toggle" class="icon-btn" aria-label="Toggle colour theme">
        <svg class="sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <a class="nav-gh" href={GITHUB} target="_blank" rel="noopener noreferrer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
  <div class="nav-progress" aria-hidden="true"></div>
</nav>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 48px;
    background: var(--nav-bg);
    border-bottom: 1px solid var(--bdr);
    backdrop-filter: blur(14px) saturate(140%);
  }

  .nav-inner {
    max-width: 1320px;
    height: 100%;
    margin: 0 auto;
    padding-inline: 24px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .nav-tag {
    padding-left: 14px;
    border-left: 1px solid var(--bdr);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--txt-3);
    white-space: nowrap;
  }

  .nav-mid {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 22px;
  }

  .nav-link {
    display: inline-flex;
    gap: 6px;
    font-size: 12px;
    color: var(--txt-2);
    transition: color 0.15s;
  }

  .nav-link span {
    color: var(--txt-4);
  }

  .nav-link:hover {
    color: var(--txt);
  }

  .nav-link:hover span {
    color: var(--amber);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .nav-ver {
    padding: 0 8px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--bdr);
    font-size: 11px;
    color: var(--amber);
  }

  .icon-btn,
  .nav-gh {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 28px;
    min-width: 28px;
    border: 1px solid var(--bdr-hi);
    background: transparent;
    color: var(--txt-2);
    font-size: 12px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .nav-gh {
    padding: 0 10px;
  }

  .icon-btn:hover,
  .nav-gh:hover {
    color: var(--txt);
    border-color: var(--amber-line);
    background: var(--amber-wash);
  }

  :root[data-theme='dark'] .icon-btn .moon,
  :root[data-theme='light'] .icon-btn .sun {
    display: none;
  }

  .nav-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--amber);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  @media (max-width: 1040px) {
    .nav-mid { display: none; }
  }

  @media (max-width: 520px) {
    .nav-inner { padding-inline: 16px; gap: 10px; }
    .nav-tag,
    .nav-ver,
    .nav-gh span { display: none; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.nav-progress');
  const onScroll = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    if (bar) bar.style.transform = `scaleX(${max > 0 ? Math.min(window.scrollY / max, 1) : 0})`;
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next =
      document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* private mode: theme just won't persist */
    }
  });
</script>
