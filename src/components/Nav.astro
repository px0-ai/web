---
import { GITHUB, DOCS } from '../data/links';

const sections = [
  { href: '/usecases', label: 'Usecases' },
  { href: '/comparisons', label: 'Comparisons' },
];
---

<nav>
  <div class="nav-inner">
    <a href="/" class="logo-link" aria-label="px0 home">
      <img src="/logo/px0-logo-dark.png" alt="px0" class="logo-img logo-dark" />
      <img src="/logo/px0-logo-light.png" alt="px0" class="logo-img logo-light" />
    </a>

    <div class="nav-mid">
      {sections.map((s) => <a class="nav-link" href={s.href}>{s.label}</a>)}
    </div>

    <div class="nav-right">
      <a class="nav-link nav-link--docs" href={DOCS} target="_blank" rel="noopener noreferrer">Docs</a>

      <button id="theme-toggle" class="icon-btn" aria-label="Toggle colour theme">
        <svg class="sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <a class="icon-btn" href={GITHUB} target="_blank" rel="noopener noreferrer" aria-label="px0 on GitHub">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
    </div>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 62px;
    border-bottom: 1px solid transparent;
    transition: background-color 0.3s, border-color 0.3s, backdrop-filter 0.3s;
  }

  nav.pinned {
    background: var(--nav-bg);
    border-bottom-color: var(--bdr);
    backdrop-filter: blur(18px) saturate(140%);
  }

  .nav-inner {
    max-width: 1180px;
    height: 100%;
    margin: 0 auto;
    padding: 0 28px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-mid {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 26px;
    padding-left: 12px;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-link {
    font-size: 13px;
    font-weight: 500;
    color: var(--txt-2);
    transition: color 0.15s;
  }

  .nav-link:hover {
    color: var(--txt);
  }

  .nav-link--docs {
    font-family: var(--mono);
    font-size: 12px;
    margin-right: 4px;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--r-sm);
    border: 1px solid var(--bdr);
    background: var(--surface);
    color: var(--txt-2);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .icon-btn:hover {
    color: var(--txt);
    border-color: var(--bdr-hi);
    background: var(--surface-2);
  }

  :root[data-theme='dark'] .icon-btn .moon,
  :root[data-theme='light'] .icon-btn .sun {
    display: none;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 15px;
    border-radius: var(--r-sm);
    background: var(--amber);
    color: #12100a;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: -0.005em;
    transition: filter 0.15s, box-shadow 0.2s;
  }

  .nav-cta:hover {
    filter: brightness(1.08);
    box-shadow: 0 6px 22px -8px var(--amber-glow);
  }

  @media (max-width: 940px) {
    .nav-mid { display: none; }
    .nav-inner { justify-content: space-between; }
  }

  @media (max-width: 520px) {
    .nav-inner { padding: 0 18px; gap: 12px; }
    .nav-link--docs { display: none; }
  }
</style>

<script>
  const nav = document.querySelector('nav');
  const onScroll = () => nav?.classList.toggle('pinned', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next =
      document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* private mode: theme just won't persist */
    }
  });
</script>
