---
const cases = [
  {
    num: '01',
    tag: 'agent workflow',
    title: 'Verifying AI Agent Output',
    desc: 'Trace symbol references, inspect live git diffs against HEAD, review generated code, and close the tab without leaving your terminal flow.',
    meta: [
      { label: 'diff vs HEAD', val: 'Ctrl D' },
      { label: 'symbol jump', val: 'F12' },
      { label: 'context switch', val: '0' },
    ],
    snippet: [
      '<span class="c-dim">$</span> claude code "refactor auth middleware"',
      '<span class="c-ok">✓</span> 8 files changed · 32 tests passing',
      '<span class="c-dim">$</span> <span class="c-hi">px0 .</span>',
      '<span class="c-out">→ browser opens instantly at http://localhost:6789</span>',
    ],
  },
  {
    num: '02',
    tag: 'zero-ssh remote',
    title: 'Remote & Cloud Server Inspection',
    desc: 'Spin up on any remote server, VM, or CI runner and browse the codebase instantly from your local browser: no SSH keys, no port forwarding hassle, and no heavy remote desktop daemons.',
    meta: [
      { label: 'setup required', val: 'zero' },
      { label: 'port forward', val: 'none' },
      { label: 'transport', val: 'HTTP / TLS' },
    ],
    snippet: [
      '<span class="c-dim">runner@ci-box:~/repo$</span> <span class="c-hi">px0 -host 0.0.0.0</span>',
      '<span class="c-out">px0 v0.1.4 · listening on http://10.0.4.12:6789</span>',
      '<span class="c-dim">local-laptop:~$</span> <span class="c-hi">open http://dev-runner:6789</span>',
      '<span class="c-ok">✓</span> connected directly from local browser',
    ],
  },
  {
    num: '03',
    tag: 'massive repos',
    title: 'Auditing Large Repositories',
    desc: 'Read through massive, 50,000+ file codebases on a laptop without background indexers hogging RAM or spinning up fans.',
    meta: [
      { label: 'linux kernel', val: '95,710 files' },
      { label: 'index time', val: '370 ms' },
      { label: 'idle memory', val: '~20 MB' },
    ],
    snippet: [
      '<span class="c-dim">$</span> <span class="c-hi">px0 ~/src/linux</span>',
      '<span class="c-out">indexed 95,710 files in 370 ms · RSS 20.4 MB</span>',
      '<span class="c-dim">$</span> <span class="c-dim"># fuzzy search in 6 ms · CPU &lt; 1%</span>',
      '<span class="c-ok">✓</span> smooth scrolling across million-line trees',
    ],
  },
  {
    num: '04',
    tag: 'companion setup',
    title: 'Sidecar to Terminal Editors',
    desc: 'Keep lightweight editors (like Vim, Neovim, or Helix) in the terminal for typing, while using px0 as a high-density, rich graphical inspection and diff console.',
    meta: [
      { label: 'typing speed', val: 'terminal' },
      { label: 'inspection', val: 'graphical' },
      { label: 'footprint', val: '~20 MB' },
    ],
    snippet: [
      '<span class="c-dim">tmux pane 1:</span> <span class="c-hi">nvim main.go</span> <span class="c-dim">(fast keyboard editing)</span>',
      '<span class="c-dim">tmux pane 2:</span> <span class="c-hi">px0 .</span> <span class="c-dim">(starts in &lt;1 ms)</span>',
      '<span class="c-dim">browser:</span> side-by-side git diffs, Markdown & symbols',
      '<span class="c-ok">✓</span> best of both worlds: modal editing + GUI clarity',
    ],
  },
];
---

<section class="sec" id="cases">
  <div class="wrap">
    <header class="sec-head">
      <div class="sec-id"><span class="sec-n">01</span><span>/cases</span></div>
      <div>
        <h2 class="sec-title">Where px0 <em>fits in best.</em></h2>
        <p class="sec-sub">
          When you just need to inspect, navigate, and audit code without booting an editor,
          waiting on heavy background indexers, or burning gigabytes of RAM.
        </p>
      </div>
    </header>

    <div class="cases-grid">
      {cases.map((c) => (
        <article class="case-card reveal">
          <div class="case-top">
            <div class="case-num">
              <b>{c.num}</b>
              <span class="case-tag">{c.tag}</span>
            </div>
            <div class="case-dot" aria-hidden="true"></div>
          </div>

          <h3 class="case-title">{c.title}</h3>
          <p class="case-desc">{c.desc}</p>

          <div class="case-tty">
            <div class="tty-bar">
              <span class="tty-bullet"></span>
              <span class="tty-title">{c.title.toLowerCase()}</span>
            </div>
            <pre class="tty-body" set:html={c.snippet.join('\n')}></pre>
          </div>

          <div class="case-stats">
            {c.meta.map((m) => (
              <div class="case-stat">
                <span class="cs-label">{m.label}</span>
                <b class="cs-val">{m.val}</b>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .case-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--bdr);
    padding: 24px;
    position: relative;
    transition: border-color 0.2s, transform 0.2s;
  }

  .case-card:hover {
    border-color: var(--amber-line);
  }

  .case-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .case-num {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
  }

  .case-num b {
    color: var(--amber);
    font-weight: 700;
  }

  .case-tag {
    text-transform: uppercase;
    color: var(--txt-3);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    padding-left: 10px;
    border-left: 1px solid var(--bdr);
  }

  .case-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--txt-4);
  }

  .case-card:hover .case-dot {
    background: var(--amber);
    box-shadow: 0 0 6px var(--amber);
  }

  .case-title {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 10px;
    color: var(--txt);
    letter-spacing: -0.02em;
  }

  .case-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--txt-2);
    margin: 0 0 20px;
    flex-grow: 1;
  }

  .case-tty {
    background: var(--bg);
    border: 1px solid var(--bdr);
    margin-bottom: 20px;
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  .tty-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-bottom: 1px solid var(--bdr);
    background: var(--bg-card);
  }

  .tty-bullet {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--amber);
  }

  .tty-title {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--txt-3);
  }

  .tty-body {
    padding: 12px 14px;
    margin: 0;
    line-height: 1.6;
    color: var(--txt-2);
    overflow-x: auto;
  }

  :global(.c-dim) {
    color: var(--txt-4);
  }

  :global(.c-hi) {
    color: var(--txt);
    font-weight: 600;
  }

  :global(.c-ok) {
    color: var(--green, #4ade80);
    font-weight: 600;
  }

  :global(.c-out) {
    color: var(--amber);
  }

  .case-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding-top: 14px;
    border-top: 1px solid var(--bdr);
  }

  .case-stat {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cs-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--txt-3);
    font-family: var(--font-mono);
  }

  .cs-val {
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--txt);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .cases-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 600px) {
    .case-card {
      padding: 18px;
    }

    .case-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
