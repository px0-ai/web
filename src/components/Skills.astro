---
const skillFeatures = [
  {
    icon: "📁 files",
    color: "#38bdf8",
    title: "Multi-File Workspaces",
    desc: "Every skill version maintains a complete, structured file tree. Edit individual code files or configure assets in-place, or upload/download ZIP packages of your entire codebase.",
    tag: "git-like workspace",
  },
  {
    icon: "↗ status",
    color: "#facc15",
    title: "Promotion Pipelines",
    desc: "Promote skills across safe operational stages: draft → stable → live. Easily manage promotion flows and demote/archive older logical versions seamlessly.",
    tag: "draft · stable · live",
  },
  {
    icon: "🔒 lock",
    color: "#10b981",
    title: "Immutable Snapshots",
    desc: "All active and stable skill versions are completely frozen. Guarantee 100% predictable and drift-free runtime execution in production environments.",
    tag: "zero behavioral drift",
  },
  {
    icon: "⎘ copy",
    color: "#a78bfa",
    title: "Instant Branching",
    desc: "Instantly duplicate any version's entire file tree to a new draft. Safely experiment, debug, or implement new logic without affecting live skills.",
    tag: "duplicate & branch",
  },
  {
    icon: "🔗 slug",
    color: "#8b5cf6",
    title: "Semantic Slug Routing",
    desc: "Access and execute functional skills by human-readable slugs or secure UUIDs. Decouple your agent calling code from backend skill versioning.",
    tag: "slug-based lookups",
  },
  {
    icon: "⚡ zip",
    color: "#f59e0b",
    title: "Multipart ZIP Uploads",
    desc: "Provision skill runtimes in bulk. Bundle your script directories, packages, and custom configuration schemas into a single ZIP file and upload.",
    tag: "bulk provisioning",
  },
];
---

<section class="features" id="skill-registry">
  <div class="container">
    <p class="section-eyebrow">// extend agent capabilities</p>
    <h2 class="section-heading">Skill Registry</h2>
    <div class="feature-grid">
      {skillFeatures.map(f => (
        <div class="feature-card">
          <div class="f-icon" style={`color:${f.color}`}>{f.icon}</div>
          <h3 class="f-title">{f.title}</h3>
          <p class="f-desc">{f.desc}</p>
          <span
            class="f-tag"
            style={`color:${f.color};border-color:${f.color}33;background:${f.color}0f`}
          >{f.tag}</span>
        </div>
      ))}
    </div>
  </div>
</section>
