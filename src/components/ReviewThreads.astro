---
// ReviewThreads.astro: Dedicated section for Agent Threads, GitHub PR Review, Inline Comments, and Batch Editing
const pillars = [
  {
    num: '01',
    title: 'Multi-Turn Agent Threads',
    sub: 'Persistent context alongside code',
    body: 'Anchor conversations to code ranges with Alt+T or line gutter icons. Stream real-time tool steps and replies over Server-Sent Events, preserved locally in atomic disk transcripts that survive restarts.',
    tag: 'Alt+T · SSE STREAM',
  },
  {
    num: '02',
    title: 'Instant GitHub PR Review',
    sub: 'Scoped merge-base diffs from URL',
    body: 'Pass any PR URL to inspect scoped merge-base diffs in an isolated ephemeral worktree in 12 ms. Review true changes against target branches without branch switching or dirtying your local tree.',
    tag: 'px0 <pr-url>',
  },
  {
    num: '03',
    title: 'Inline Comments & Line Actions',
    sub: 'Hover gutter icons or chord Alt+R',
    body: 'Hover any line number for the contextual thread icon, or press Alt+R to draft inline review notes. Comments stay anchored in memory until you submit formal reviews to GitHub or send them to your agent.',
    tag: 'Alt+R · GUTTER ICON',
  },
  {
    num: '04',
    title: 'Queued Batch Inline Edits',
    sub: 'Stage comments across files with Alt+E',
    body: 'Highlight code in diff or source views, press Alt+E, and stage edit prompts across multiple files. Review queued comments in the Threads drawer and apply all at once with Mod+Enter.',
    tag: 'Alt+E · Mod+Enter',
  },
  {
    num: '05',
    title: 'Multi-Harness Continuity',
    sub: 'Claude, Gemini, Cursor, Agy & more',
    body: 'Connect natively to Claude Code, Gemini CLI, Cursor Agent, Antigravity, OpenCode, Codex, Aider, or Goose. Switch models or harnesses mid-thread with automatic session resume and transcript replay.',
    tag: '8+ HARNESSES',
  },
  {
    num: '06',
    title: 'GitHub Reviews & PR Push',
    sub: 'Approve, request changes, and push fixes',
    body: 'Submit formal approvals or change requests directly to GitHub with your inline notes attached. Review AI-generated commit messages and push fixes straight back to PR head branches without a terminal.',
    tag: 'APPROVE · COMMIT · PUSH',
  },
];
---

<section class="sec" id="review">
  <div class="wrap">
    <header class="sec-head">
      <div class="sec-id"><span class="sec-n">02</span><span>/review</span></div>
      <div>
        <h2 class="sec-title"><em>Threads</em> & code review.</h2>
        <p class="sec-sub">
          Review GitHub PRs, leave inline comments, and make code-level edits directly in place.
          Trigger quick inline fixes with <code class="inline-code">Alt+E</code> or guide multi-step code changes across files with agent threads, watching every tool step execute live.
        </p>
      </div>
    </header>

    <!-- Main interactive showcase panel in light mode -->
    <div class="rev-showcase pnl reveal">
      <div class="pnl-h">
        <div class="rev-tab-group" role="tablist">
          <button class="rev-tab on" id="tab-rev-threads" type="button" role="tab" aria-selected="true" aria-controls="view-rev-threads">
            <span class="tab-ico">💬</span>
            <span>Agent Threads</span>
            <span class="rev-pill pill-violet">Alt+T</span>
          </button>
          <button class="rev-tab" id="tab-rev-pr" type="button" role="tab" aria-selected="false" aria-controls="view-rev-pr">
            <span class="tab-ico">⎇</span>
            <span>GitHub PR Review</span>
            <span class="rev-pill pill-amber">#123</span>
          </button>
          <button class="rev-tab" id="tab-rev-batch" type="button" role="tab" aria-selected="false" aria-controls="view-rev-batch">
            <span class="tab-ico">⚡</span>
            <span>Batch Inline Edits</span>
            <span class="rev-pill pill-cyan">Alt+E</span>
          </button>
        </div>

        <div class="rev-top-meta">
          <span class="meta-status-dot"></span>
          <span class="meta-label" id="rev-meta-text">Harness: <b>claude-3-7-sonnet</b> · Live SSE stream</span>
        </div>
      </div>

      <!-- VIEW 1: AGENT THREADS -->
      <div class="rev-view" id="view-rev-threads" role="tabpanel">
        <div class="threads-layout">
          <!-- Left: Code Editor Context Preview -->
          <div class="threads-code-side">
            <div class="side-hdr">
              <div class="side-file-info">
                <span class="file-icon">📄</span>
                <span class="file-name">internal/auth/token.go</span>
                <span class="anchor-badge">@token.go:38-44</span>
              </div>
              <span class="side-hint">anchored editor context</span>
            </div>

            <div class="editor-view">
              <div class="code-line"><span class="ln">38</span><span class="cl-tx"><span class="k">func</span> <span class="fn">ResolveToken</span>(cfg <span class="ty">Config</span>) (<span class="ty">string</span>, <span class="ty">error</span>) &#123;</span></div>
              <div class="code-line cl-anchored"><span class="ln">39</span><span class="cl-tx">    <span class="k">if</span> tok := cfg.<span class="pr">GitHubToken</span>; tok != <span class="s">""</span> &#123;</span></div>
              <div class="code-line cl-anchored"><span class="ln">40</span><span class="cl-tx">        <span class="k">return</span> tok, nil</span></div>
              <div class="code-line cl-anchored cl-highlighted">
                <span class="ln">41</span>
                <span class="cl-tx">        <span class="k">return</span> os.<span class="fn">Getenv</span>(<span class="s">"GITHUB_TOKEN"</span>), nil</span>
                <span class="gutter-thread-icon" title="Thread anchored here">💬</span>
              </div>
              <div class="code-line cl-anchored"><span class="ln">42</span><span class="cl-tx">    &#125;</span></div>
              <div class="code-line cl-anchored"><span class="ln">43</span><span class="cl-tx">    <span class="k">return</span> <span class="fn">resolveGhCliToken</span>()</span></div>
              <div class="code-line"><span class="ln">44</span><span class="cl-tx">&#125;</span></div>
            </div>

            <div class="editor-foot">
              <span class="ef-tag">Selection active · press <kbd class="alt-key">Alt</kbd><kbd>T</kbd> to start thread</span>
              <span class="ef-stat">46 lines · Go 1.24</span>
            </div>
          </div>

          <!-- Right: Threads Sidebar Pane -->
          <div class="threads-pane-side">
            <div class="tp-hdr">
              <div class="tp-title-row">
                <span class="tp-icon">#4</span>
                <span class="tp-title">Refactor auth token fallback</span>
