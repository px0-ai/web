<script>
  const initReviewShowcase = () => {
    const tabThreads = document.getElementById('tab-rev-threads');
    const tabPr = document.getElementById('tab-rev-pr');
    const tabBatch = document.getElementById('tab-rev-batch');

    const viewThreads = document.getElementById('view-rev-threads');
    const viewPr = document.getElementById('view-rev-pr');
    const viewBatch = document.getElementById('view-rev-batch');

    const metaText = document.getElementById('rev-meta-text');

    if (!tabThreads || !tabPr || !tabBatch || !viewThreads || !viewPr || !viewBatch) return;

    const setTab = (activeTab: HTMLElement, activeView: HTMLElement, meta: string) => {
      [tabThreads, tabPr, tabBatch].forEach((t) => {
        t.classList.remove('on');
        t.setAttribute('aria-selected', 'false');
      });
      [viewThreads, viewPr, viewBatch].forEach((v) => v.classList.add('is-hidden'));

      activeTab.classList.add('on');
      activeTab.setAttribute('aria-selected', 'true');
      activeView.classList.remove('is-hidden');
      if (metaText) metaText.innerHTML = meta;
    };

    tabThreads.addEventListener('click', () => {
      setTab(tabThreads, viewThreads, 'Harness: <b>claude-3-7-sonnet</b> · Live SSE stream');
    });

    tabPr.addEventListener('click', () => {
      setTab(tabPr, viewPr, 'GitHub PR: <b>#123</b> · Scoped merge-base diff (8f2a1c)');
    });

    tabBatch.addEventListener('click', () => {
      setTab(tabBatch, viewBatch, 'Batch Queue: <b>2 staged comments</b> · Mod+Enter to apply');
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReviewShowcase);
  } else {
    initReviewShowcase();
  }
</script>

<style>
