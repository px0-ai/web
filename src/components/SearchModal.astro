---
// SearchModal.astro - Fast, lightweight terminal-style search modal with rich UI
---

<div id="search-modal" class="search-modal" role="dialog" aria-modal="true" aria-label="Site Search" hidden>
  <div class="search-backdrop" data-close-search></div>

  <div class="search-box">
    <!-- Header with prompt and input -->
    <div class="search-header">
      <span class="search-prompt" aria-hidden="true">&gt;</span>
      <input
        type="search"
        id="search-input"
        class="search-input"
        placeholder="Search documentation, guides, reference, blog..."
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
      />
      <button class="search-close-btn" data-close-search aria-label="Close search (Esc)">
        <kbd class="key-hint">ESC</kbd>
      </button>
    </div>

    <!-- Modal Content Body -->
    <div class="search-body">
      <!-- Default state: Quick navigation shortcuts -->
      <div id="search-empty" class="search-empty">
        <div class="empty-header">
          <span class="empty-prompt">//</span>
          <span class="empty-title">Popular Guides & Reference</span>
        </div>
        <div class="quick-links">
          <a href="/docs/getting-started/quickstart" class="quick-link">
            <span class="ql-badge ql-docs">Docs</span>
            <span class="ql-title">Quickstart & First Session</span>
            <span class="ql-path">getting-started / quickstart</span>
          </a>
          <a href="/docs/reference/cli-flags" class="quick-link">
            <span class="ql-badge ql-ref">Ref</span>
            <span class="ql-title">CLI Flags & Parameters</span>
            <span class="ql-path">reference / cli-flags</span>
          </a>
          <a href="/docs/reference/keyboard-shortcuts" class="quick-link">
            <span class="ql-badge ql-ref">Ref</span>
            <span class="ql-title">Keyboard Shortcuts Reference</span>
            <span class="ql-path">reference / shortcuts</span>
          </a>
          <a href="/docs/guides/pairing-with-agents" class="quick-link">
            <span class="ql-badge ql-guide">Guide</span>
            <span class="ql-title">Pairing with Autonomous Coding Agents</span>
            <span class="ql-path">guides / pairing-with-agents</span>
          </a>
          <a href="/docs/guides/github-pr-review" class="quick-link">
            <span class="ql-badge ql-guide">Guide</span>
            <span class="ql-title">GitHub PR Review & Collaboration</span>
            <span class="ql-path">guides / github-pr-review</span>
          </a>
          <a href="/docs/guides/docker-and-containers" class="quick-link">
            <span class="ql-badge ql-guide">Guide</span>
            <span class="ql-title">Running px0 in Docker & Containers</span>
            <span class="ql-path">guides / docker</span>
          </a>
          <a href="/blog/ides-are-dead-long-live-the-ide" class="quick-link">
            <span class="ql-badge ql-blog">Blog</span>
            <span class="ql-title">IDEs Are Dead, Long Live the IDE</span>
            <span class="ql-path">blog / ides-are-dead</span>
          </a>
        </div>
      </div>

      <!-- Loading State -->
      <div id="search-loading" class="search-state" hidden>
        <span class="spinner-dots">Indexing documentation...</span>
      </div>

      <!-- No Results State -->
      <div id="search-no-results" class="search-state" hidden>
        <p class="no-res-msg">No results matching "<span id="no-match-term"></span>"</p>
        <p class="no-res-hint">Try searching for keywords like <code>docker</code>, <code>flags</code>, <code>keys</code>, <code>sudo</code>, or <code>lsp</code>.</p>
      </div>

      <!-- Live Search Results List -->
      <ul id="search-results-list" class="search-results-list" role="listbox" hidden></ul>
    </div>

    <!-- Modal Footer with command keys and count -->
    <div class="search-footer">
      <div class="footer-nav-hints">
        <span class="hint-item"><kbd>&uarr;</kbd><kbd>&darr;</kbd> navigate</span>
        <span class="hint-item"><kbd>&crarr;</kbd> select</span>
        <span class="hint-item"><kbd>esc</kbd> close</span>
      </div>
      <div id="search-count" class="search-count">px0 search</div>
    </div>
  </div>
</div>

<style>
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 10vh 16px 24px;
    font-family: var(--mono);
  }

  .search-modal[hidden] {
    display: none;
  }

  .search-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(3, 4, 7, 0.82);
    backdrop-filter: blur(10px) saturate(130%);
    z-index: 1;
    animation: fadeIn 0.12s ease-out;
  }

  .search-box {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 680px;
    background: var(--bg-elev);
    border: 1px solid var(--bdr-hi);
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.8), 0 0 0 1px var(--bdr);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: scaleIn 0.12s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes scaleIn {
    from { opacity: 0; transform: translateY(-10px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .search-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: var(--panel);
    border-bottom: 1px solid var(--bdr);
  }

  .search-prompt {
    color: var(--amber);
    font-size: 16px;
    font-weight: 700;
    user-select: none;
    line-height: 1;
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--txt);
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.4;
  }

  .search-input::placeholder {
    color: var(--txt-3);
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close-btn {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .key-hint {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px 6px;
    font-size: 10px;
    color: var(--txt-3);
    background: var(--surface-2);
    border: 1px solid var(--bdr);
    border-radius: 0;
    user-select: none;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
    font-family: var(--mono);
  }

  .search-close-btn:hover .key-hint {
    color: var(--txt);
    border-color: var(--amber-line);
    background: var(--amber-wash);
  }

  .search-body {
    max-height: min(60vh, 520px);
    overflow-y: auto;
    padding: 12px 0;
    scrollbar-width: thin;
    scrollbar-color: var(--bdr-hi) transparent;
  }

  .search-body::-webkit-scrollbar {
    width: 6px;
  }

  .search-body::-webkit-scrollbar-thumb {
    background: var(--bdr-hi);
  }

  /* Empty state */
  .search-empty {
    padding: 8px 16px 12px;
  }

  .empty-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--txt-3);
  }

  .empty-prompt {
    color: var(--amber);
  }

  .quick-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .quick-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    border: 1px solid transparent;
    background: var(--surface);
    color: var(--txt-2);
    text-decoration: none;
    font-size: 12.5px;
    transition: background 0.1s, border-color 0.1s, color 0.1s;
  }

  .quick-link:hover {
    background: var(--amber-wash);
    border-color: var(--amber-line);
    color: var(--txt);
  }

  .ql-badge {
    font-size: 9.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 2px 6px;
    border: 1px solid var(--bdr);
    flex-shrink: 0;
  }

  .ql-docs {
    background: rgba(251, 191, 36, 0.08);
    border-color: rgba(251, 191, 36, 0.25);
    color: var(--amber);
  }

  .ql-ref {
    background: rgba(125, 207, 255, 0.08);
    border-color: rgba(125, 207, 255, 0.25);
    color: var(--cyan);
  }

  .ql-guide {
    background: rgba(187, 154, 247, 0.08);
    border-color: rgba(187, 154, 247, 0.25);
    color: var(--violet);
  }

  .ql-blog {
    background: rgba(187, 154, 247, 0.08);
    border-color: rgba(187, 154, 247, 0.25);
    color: var(--violet);
  }

  .ql-title {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ql-path {
    font-size: 10.5px;
    color: var(--txt-3);
    flex-shrink: 0;
  }

  /* States */
  .search-state {
    padding: 40px 20px;
    text-align: center;
    color: var(--txt-3);
  }

  .no-res-msg {
    margin: 0 0 8px;
    font-size: 13.5px;
    color: var(--txt);
  }

  .no-res-msg span {
    color: var(--amber);
    font-weight: 600;
  }

  .no-res-hint {
    margin: 0;
    font-size: 11.5px;
    color: var(--txt-3);
  }

  .no-res-hint code {
    color: var(--amber);
    background: var(--surface-2);
    border: 1px solid var(--bdr);
    padding: 1px 4px;
    font-size: 11px;
  }

  /* Footer */
  .search-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 18px;
    background: var(--panel);
    border-top: 1px solid var(--bdr);
    font-size: 11px;
    color: var(--txt-3);
  }

  .footer-nav-hints {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hint-item {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .hint-item kbd {
    padding: 1px 4px;
    background: var(--surface-2);
    border: 1px solid var(--bdr);
    color: var(--txt-2);
    font-size: 9.5px;
    line-height: 1;
  }

  .search-count {
    color: var(--txt-3);
    font-size: 11px;
  }

  @media (max-width: 640px) {
    .search-modal {
      padding-top: 4vh;
      padding-inline: 10px;
    }
    .footer-nav-hints,
    .ql-path {
      display: none;
    }
  }

  /* ═══════════════════════════════════════════════════════════════
     Search Results List Styling
     Using :global() to ensure dynamic JS elements receive styling
     ═══════════════════════════════════════════════════════════════ */

  .search-modal :global(.search-results-list) {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 16px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
  }

  .search-modal :global(.search-results-list li) {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .search-modal :global(.search-result-item) {
    display: flex !important;
    flex-direction: column !important;
    gap: 5px !important;
    padding: 10px 14px !important;
    background: var(--surface) !important;
    border: 1px solid var(--bdr) !important;
    text-decoration: none !important;
    cursor: pointer !important;
    position: relative !important;
    transition: background 0.1s ease, border-color 0.1s ease, box-shadow 0.1s ease !important;
  }

  .search-modal :global(.search-result-item:hover),
  .search-modal :global(.search-result-item.selected) {
    background: var(--amber-wash) !important;
    border-color: var(--amber-line) !important;
    box-shadow: inset 3px 0 0 var(--amber) !important;
  }

  .search-modal :global(.result-top) {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 12px !important;
  }

  .search-modal :global(.result-badges) {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    flex-shrink: 0 !important;
  }

  .search-modal :global(.result-badge) {
    font-size: 9.5px !important;
    font-weight: 600 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    padding: 1.5px 5px !important;
    border: 1px solid var(--bdr) !important;
    background: var(--surface-2) !important;
    color: var(--txt-3) !important;
    line-height: 1.2 !important;
  }

  .search-modal :global(.badge-docs) {
    color: var(--amber) !important;
    border-color: rgba(251, 191, 36, 0.25) !important;
    background: rgba(251, 191, 36, 0.08) !important;
  }

  .search-modal :global(.badge-blog) {
    color: var(--violet) !important;
    border-color: rgba(187, 154, 247, 0.25) !important;
    background: rgba(187, 154, 247, 0.08) !important;
  }

  .search-modal :global(.badge-changelog) {
    color: var(--green) !important;
    border-color: rgba(158, 206, 106, 0.25) !important;
    background: rgba(158, 206, 106, 0.08) !important;
  }

  .search-modal :global(.result-cat) {
    font-size: 10.5px !important;
    color: var(--txt-3) !important;
    text-transform: lowercase !important;
  }

  .search-modal :global(.result-url) {
    font-size: 10px !important;
    color: var(--txt-3) !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    direction: rtl !important;
    text-align: left !important;
  }

  .search-modal :global(.result-title-row) {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 12px !important;
  }

  .search-modal :global(.result-title) {
    font-size: 13.5px !important;
    font-weight: 600 !important;
    color: var(--txt) !important;
    line-height: 1.3 !important;
  }

  .search-modal :global(.result-enter-icon) {
    font-size: 13px !important;
    color: var(--amber) !important;
    opacity: 0 !important;
    transform: translateX(-4px) !important;
    transition: opacity 0.12s ease, transform 0.12s ease !important;
    flex-shrink: 0 !important;
  }

  .search-modal :global(.search-result-item.selected .result-enter-icon) {
    opacity: 1 !important;
    transform: translateX(0) !important;
  }

  .search-modal :global(.result-desc) {
    margin: 0 !important;
    font-size: 11.5px !important;
    color: var(--txt-3) !important;
    line-height: 1.45 !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
  }

  .search-modal :global(.search-result-item.selected .result-desc) {
    color: var(--txt-2) !important;
  }

  .search-modal :global(.search-highlight) {
    color: var(--amber) !important;
    background: rgba(251, 191, 36, 0.18) !important;
    font-weight: 600 !important;
    padding: 0 3px !important;
    border-radius: 1px !important;
    box-shadow: 0 0 0 1px rgba(251, 191, 36, 0.28) !important;
  }
</style>

<script>
  import MiniSearch from 'minisearch';

  interface SearchItem {
    id: string;
    url: string;
    title: string;
    description: string;
    category: string;
    type: 'Docs' | 'Blog';
    body: string;
  }

  let miniSearch: MiniSearch<SearchItem> | null = null;
  let rawItems: SearchItem[] = [];
  let isIndexing = false;
  let selectedIndex = 0;
  let currentResults: SearchItem[] = [];

  const modal = document.getElementById('search-modal');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const emptyState = document.getElementById('search-empty');
  const loadingState = document.getElementById('search-loading');
  const noResultsState = document.getElementById('search-no-results');
  const noMatchTerm = document.getElementById('no-match-term');
  const resultsList = document.getElementById('search-results-list');
  const searchCount = document.getElementById('search-count');

  function escapeHtml(text: string): string {
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function highlightMatches(text: string, query: string): string {
    if (!text) return '';
    const safeText = escapeHtml(text);
    const trimmed = query.trim();
    if (!trimmed) return safeText;

    const terms = trimmed.split(/\s+/).filter((t) => t.length > 1);
    if (terms.length === 0) return safeText;

    const pattern = terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
    const regex = new RegExp(`(${pattern})`, 'gi');
    return safeText.replace(regex, '<mark class="search-highlight">$1</mark>');
  }

  async function loadIndex(): Promise<void> {
    if (miniSearch || isIndexing) return;
    isIndexing = true;
    if (loadingState) loadingState.hidden = false;

    try {
      const res = await fetch('/search.json?v=' + Date.now(), { cache: 'no-cache' });
      rawItems = await res.json();

      miniSearch = new MiniSearch<SearchItem>({
        fields: ['title', 'description', 'category', 'body'],
        storeFields: ['id', 'url', 'title', 'description', 'category', 'type', 'body'],
        searchOptions: {
          boost: { title: 3, category: 2, description: 1.5, body: 1 },
          fuzzy: 0.2,
          prefix: true,
        },
      });

      miniSearch.addAll(rawItems);
    } catch (err) {
      console.error('Failed to load search index:', err);
    } finally {
      isIndexing = false;
      if (loadingState) loadingState.hidden = true;
    }
  }

  function openSearch(): void {
    if (!modal) return;
    modal.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    loadIndex();
    setTimeout(() => {
      input?.focus();
      input?.select();
    }, 15);
  }

  function closeSearch(): void {
    if (!modal) return;
    modal.setAttribute('hidden', '');
    document.body.style.overflow = '';
    if (input) input.value = '';
    renderEmpty();
  }

  function renderEmpty(): void {
    currentResults = [];
    selectedIndex = 0;
    if (emptyState) emptyState.hidden = false;
    if (resultsList) {
      resultsList.hidden = true;
      resultsList.innerHTML = '';
    }
    if (noResultsState) noResultsState.hidden = true;
    if (searchCount) searchCount.textContent = 'px0 search';
  }

  function updateSelection(): void {
    if (!resultsList) return;
    const items = resultsList.querySelectorAll<HTMLElement>('.search-result-item');
    items.forEach((el, idx) => {
      if (idx === selectedIndex) {
        el.classList.add('selected');
        el.setAttribute('aria-selected', 'true');
        el.scrollIntoView({ block: 'nearest' });
      } else {
        el.classList.remove('selected');
        el.setAttribute('aria-selected', 'false');
      }
    });
  }

  function performSearch(query: string): void {
    const q = query.trim();
    if (!q) {
      renderEmpty();
      return;
    }

    if (!miniSearch) return;

    const matches = miniSearch.search(q);
    currentResults = matches.map((m) => m as unknown as SearchItem);

    if (emptyState) emptyState.hidden = true;

    if (currentResults.length === 0) {
      if (resultsList) {
        resultsList.hidden = true;
        resultsList.innerHTML = '';
      }
      if (noResultsState) noResultsState.hidden = false;
      if (noMatchTerm) noMatchTerm.textContent = q;
      if (searchCount) searchCount.textContent = '0 results';
      return;
    }

    if (noResultsState) noResultsState.hidden = true;
    if (resultsList) {
      resultsList.hidden = false;
      resultsList.innerHTML = '';

      currentResults.forEach((item, idx) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'option');

        const badgeClass = item.type === 'Blog' ? 'badge-blog' : 'badge-docs';

        const highlightedTitle = highlightMatches(item.title, q);
        const highlightedDesc = highlightMatches(item.description, q);

        li.innerHTML = `
          <a href="${item.url}" class="search-result-item ${idx === 0 ? 'selected' : ''}" data-index="${idx}">
            <div class="result-top">
              <div class="result-badges">
                <span class="result-badge ${badgeClass}">${item.type}</span>
                ${item.category ? `<span class="result-cat">// ${escapeHtml(item.category)}</span>` : ''}
              </div>
              <span class="result-url">${escapeHtml(item.url)}</span>
            </div>
            <div class="result-title-row">
              <span class="result-title">${highlightedTitle}</span>
              <span class="result-enter-icon" aria-hidden="true">&crarr;</span>
            </div>
            ${item.description ? `<p class="result-desc">${highlightedDesc}</p>` : ''}
          </a>
        `;

        const a = li.querySelector<HTMLAnchorElement>('.search-result-item')!;

        a.addEventListener('mouseenter', () => {
          selectedIndex = idx;
          updateSelection();
        });

        a.addEventListener('click', () => {
          closeSearch();
        });

        resultsList.appendChild(li);
      });

      selectedIndex = 0;
      updateSelection();
    }

    if (searchCount) {
      searchCount.textContent = `${currentResults.length} result${currentResults.length === 1 ? '' : 's'}`;
    }
  }

  // Keyboard navigation inside input
  input?.addEventListener('input', (e) => {
    performSearch((e.target as HTMLInputElement).value);
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (currentResults.length > 0) {
        selectedIndex = (selectedIndex + 1) % currentResults.length;
        updateSelection();
      }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (currentResults.length > 0) {
        selectedIndex = (selectedIndex - 1 + currentResults.length) % currentResults.length;
        updateSelection();
      }
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (currentResults[selectedIndex]) {
        const dest = currentResults[selectedIndex].url;
        closeSearch();
        window.location.href = dest;
      }
    } else if (e.key === 'Escape') {
      e.preventDefault();
      closeSearch();
    }
  });

  // Global triggers
  window.addEventListener('keydown', (e) => {
    const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
    const isCmdOrCtrl = isMac ? e.metaKey : e.ctrlKey;

    if (isCmdOrCtrl && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (modal?.hasAttribute('hidden')) {
        openSearch();
      } else {
        closeSearch();
      }
    } else if (e.key === '/' && modal?.hasAttribute('hidden')) {
      const active = document.activeElement?.tagName.toLowerCase();
      if (active !== 'input' && active !== 'textarea') {
        e.preventDefault();
        openSearch();
      }
    } else if (e.key === 'Escape' && !modal?.hasAttribute('hidden')) {
      e.preventDefault();
      closeSearch();
    }
  });

  // Close triggers
  document.querySelectorAll('[data-close-search]').forEach((el) => {
    el.addEventListener('click', closeSearch);
  });

  // Open triggers
  document.querySelectorAll('[data-open-search]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openSearch();
    });
    el.addEventListener('mouseenter', () => {
      loadIndex();
    });
  });
</script>
