---
// Git Awareness, GitHub PR Review & Visual Diff Viewer section
const badges = [
  { k: 'M', label: 'modified', desc: 'tracked file modified in working tree', cls: 'badge-m' },
  { k: 'A', label: 'added', desc: 'new file staged or added to git', cls: 'badge-a' },
  { k: 'D', label: 'deleted', desc: 'file removed in working tree', cls: 'badge-d' },
  { k: 'U', label: 'untracked', desc: 'file not yet tracked by repository', cls: 'badge-u' },
  { k: 'R', label: 'renamed', desc: 'path changed from original index', cls: 'badge-r' },
];

const pillars = [
  {
    num: '01',
    title: 'Native GitHub PR Review',
    sub: 'Scoped merge-base diffs from any URL',
    body: 'Pass any pull request URL to inspect diffs in an isolated ephemeral worktree. Full codebase navigation, symbols, definitions, and callers remain accessible with zero disk clutter.',
    tag: 'px0 <pr-url>',
  },
  {
    num: '02',
    title: 'Inline Comments & AI Apply',
    sub: 'Draft review notes or let AI apply them',
    body: 'Hover any line or press Alt+R to draft inline review notes. Submit formal approvals to GitHub or click Batch Apply to dispatch all comments across the PR to your local AI coding agent.',
    tag: 'Alt+R · BATCH APPLY',
  },
  {
    num: '03',
    title: 'Sidebar Git Panel & AI Commits',
    sub: 'Stage ticks, AI messages, and safe push',
    body: 'Stage per-file ticks in the tree, generate commit messages from staged diffs with AI, and push directly back to the PR head branch (including forks) without opening a terminal.',
    tag: 'STAGE · COMMIT · PUSH',
  },
];
---

<section class="sec" id="git">
  <div class="wrap">
    <header class="sec-head">
      <div class="sec-id"><span class="sec-n">05</span><span>/git</span></div>
      <div>
        <h2 class="sec-title">Native GitHub integration. <em>Review, comment, commit.</em></h2>
        <p class="sec-sub">
          Pass any pull request URL directly to px0. Inspect merge-base diffs, draft inline comments, run
          one-click batch AI edits, stage per-file ticks, commit with AI, and push fixes straight back to the PR's
          own branch without leaving your browser.
        </p>
      </div>
    </header>

    <!-- Main visual showcase: Mode toggling between PR Review & Git Panel -->
    <div class="git-showcase pnl reveal">
      <div class="pnl-h">
        <div class="mode-selectors" role="tablist">
          <button class="mode-tab on" id="tab-mode-pr" type="button">
            <span class="tab-ico">⎇</span>
            <span>GitHub PR Review</span>
            <span class="mode-pill pill-pr">#123</span>
          </button>
          <button class="mode-tab" id="tab-mode-git" type="button">
            <span class="tab-ico">●</span>
            <span>Working Tree & Git Panel</span>
            <span class="mode-pill">local</span>
          </button>
        </div>

        <div class="git-status-summary" id="showcase-summary-pr">
          <span class="gstat-pill badge-open">● Open</span>
          <span class="gstat-repo">px0-ai/px0 #123</span>
          <span class="gstat-branch">main &larr; auth-refactor</span>
        </div>

        <div class="git-status-summary is-hidden" id="showcase-summary-git">
          <span class="gstat-dot"></span>
          <span>branch: <b>feat/fast-path</b> · <b>2 staged, 1 changed</b></span>
        </div>
      </div>

      <!-- PR REVIEW MODE VIEWPORT -->
      <div class="showcase-grid mode-pr-view" id="view-mode-pr">
        <!-- Left: PR File Tree & Comments list -->
        <div class="tree-col">
          <div class="col-head">
            <span class="col-title-pr">PR #123 · 3 files changed</span>
            <div class="view-toggles" role="tablist">
              <button class="toggle-btn on" id="btn-pr-files" type="button">files</button>
              <button class="toggle-btn" id="btn-pr-comments" type="button">comments (2)</button>
            </div>
          </div>

          <ul class="mock-tree" id="pr-mock-tree">
            <li class="t-item t-dir t-dirty">
              <span class="t-chev">▾</span><span class="t-name">internal/auth</span>
            </li>
            <li class="t-item t-sub t-file t-active">
              <span class="t-indent"></span><span class="t-name">token.go</span>
              <span class="t-comment-badge" title="1 draft comment">💬 1</span>
              <span class="t-badge badge-m">M</span>
            </li>
            <li class="t-item t-sub t-file">
              <span class="t-indent"></span><span class="t-name">provider.go</span>
              <span class="t-comment-badge" title="1 draft comment">💬 1</span>
              <span class="t-badge badge-a">A</span>
            </li>
            <li class="t-item t-dir">
              <span class="t-chev">▾</span><span class="t-name">cmd</span>
            </li>
            <li class="t-item t-sub t-file">
              <span class="t-indent"></span><span class="t-name">main.go</span>
              <span class="t-badge badge-m">M</span>
            </li>
          </ul>

          <!-- PR Action Footer -->
          <div class="pr-action-card">
            <div class="pr-action-h">
              <span class="pr-h-title">Batch Apply (2)</span>
              <span class="pr-h-agent">claude-haiku</span>
            </div>
            <p class="pr-action-desc">Apply all drafted review comments across files with your local coding agent.</p>
            <div class="pr-action-btns">
              <button class="pr-btn-apply" type="button">Run Batch Apply</button>
              <button class="pr-btn-review" type="button">Submit Review &rarr;</button>
            </div>
          </div>
        </div>

        <!-- Right: Merge-Base Diff View with Inline Comment Popover -->
        <div class="diff-col">
          <div class="col-head">
            <div class="diff-meta">
              <span class="diff-tag-pr">merge-base</span>
              <span class="diff-filename">internal/auth/token.go</span>
              <span class="diff-stat"><span class="s-add">+14</span> <span class="s-del">−3</span></span>
            </div>
            <div class="diff-controls">
              <span class="diff-badge-shortcut"><kbd class="alt-key">Alt</kbd><kbd>R</kbd> comment</span>
              <span class="diff-chord"><kbd class="mod-key">Ctrl</kbd><kbd>D</kbd> diff</span>
            </div>
          </div>

          <div class="diff-viewport">
            <div class="diff-pane diff-unified">
              <div class="pane-hdr">
                <span>diff against merge-base (main @ 8f2a1c)</span>
                <span class="s-author">@alice authored</span>
              </div>
              <div class="diff-lines">
                <div class="dline"><span class="dln">38</span><span class="dln">38</span><span class="dmark"> </span><span class="dtx"><span class="k">func</span> ResolveToken(cfg Config) (string, error) {'{'}</span></div>
                <div class="dline dline-del"><span class="dln">39</span><span class="dln"> </span><span class="dmark">−</span><span class="dtx">    <span class="k">return</span> os.Getenv("GITHUB_TOKEN"), nil</span></div>
                <div class="dline dline-add"><span class="dln"> </span><span class="dln">39</span><span class="dmark">+</span><span class="dtx">    <span class="k">if</span> tok := cfg.GitHubToken; tok != "" {'{'}</span></div>
                <div class="dline dline-add"><span class="dln"> </span><span class="dln">40</span><span class="dmark">+</span><span class="dtx">        <span class="k">return</span> tok, nil</span></div>
                <div class="dline dline-add dline-comment-anchor">
                  <span class="dln"> </span><span class="dln">41</span><span class="dmark">+</span>
                  <span class="dtx">    <span class="k">if</span> tok := os.Getenv("GITHUB_TOKEN"); tok != "" {'{'}</span>
                  <span class="gutter-pencil" title="Add review comment (Alt+R)">✏</span>
                </div>

                <!-- Open Inline Comment Composer Box -->
                <div class="inline-comment-box">
                  <div class="icb-head">
                    <span class="icb-author">Draft Review Comment · line 41</span>
                    <span class="icb-tag">in-memory</span>
                  </div>
                  <div class="icb-body">
                    Check if GH_TOKEN is also set before falling back to the gh CLI binary so standard environment variables take precedence.
                  </div>
                  <div class="icb-actions">
                    <span class="icb-hint">Press <kbd>Ctrl+Enter</kbd> to save draft</span>
                    <div class="icb-btns">
                      <button class="icb-btn-cancel" type="button">Discard</button>
                      <button class="icb-btn-save" type="button">Save Draft</button>
                    </div>
                  </div>
                </div>

                <div class="dline"><span class="dln">42</span><span class="dln">42</span><span class="dmark"> </span><span class="dtx">        <span class="k">return</span> tok, nil</span></div>
                <div class="dline"><span class="dln">43</span><span class="dln">43</span><span class="dmark"> </span><span class="dtx">    {'}'}</span></div>
                <div class="dline"><span class="dln">44</span><span class="dln">44</span><span class="dmark"> </span><span class="dtx">    <span class="k">return</span> resolveGhCliToken()</span></div>
              </div>
            </div>
          </div>

          <div class="diff-foot">
            <span class="df-note">Hover any gutter line for <b>✏</b> or select code & press <kbd class="alt-key">Alt</kbd><kbd>R</kbd></span>
            <span class="df-tag">push back to pr branch enabled</span>
          </div>
        </div>
      </div>

      <!-- LOCAL WORKING TREE & GIT PANEL VIEWPORT -->
      <div class="showcase-grid mode-git-view is-hidden" id="view-mode-git">
        <!-- Left: File tree with stage ticks + Git Panel at bottom -->
        <div class="tree-col">
          <div class="col-head">
            <span>working tree</span>
            <div class="view-toggles" role="tablist">
              <button class="toggle-btn on" id="btn-tree-all" type="button">all</button>
              <button class="toggle-btn" id="btn-tree-changed" type="button">changed (3)</button>
            </div>
          </div>

          <ul class="mock-tree" id="git-mock-tree">
            <li class="t-item t-dir t-dirty">
              <span class="t-chev">▾</span><span class="t-name">internal/engine</span><span class="t-dot"></span>
            </li>
            <li class="t-item t-sub t-file t-staged">
              <span class="t-check" title="Staged in index">✓</span>
              <span class="t-name">merge_base.go</span>
              <span class="t-badge badge-m">M</span>
            </li>
            <li class="t-item t-sub t-file t-staged">
              <span class="t-check" title="Staged in index">✓</span>
              <span class="t-name">git_write.go</span>
              <span class="t-badge badge-a">A</span>
            </li>
            <li class="t-item t-sub t-file">
              <span class="t-check t-check-empty" title="Click to stage">+</span>
              <span class="t-name">git_test.go</span>
              <span class="t-badge badge-m">M</span>
            </li>
            <li class="t-item t-dir">
              <span class="t-chev">▸</span><span class="t-name">web</span>
            </li>
            <li class="t-item t-file">
              <span class="t-name">go.mod</span>
            </li>
          </ul>

          <!-- Sidebar Git Panel -->
          <div class="sidebar-git-panel">
            <div class="sgp-head">
              <span class="sgp-branch">⎇ feat/fast-path</span>
              <span class="sgp-staged-count">2 staged · 1 changed</span>
            </div>
            <div class="sgp-commit-box">
              <textarea class="sgp-input" rows="2" readonly>feat: add fast-path merge base detection</textarea>
            </div>
            <div class="sgp-actions">
              <button class="sgp-btn sgp-commit" type="button">Commit</button>
              <button class="sgp-btn sgp-ai" type="button" title="Generate commit message with agent">
                <span>Commit with AI</span>
              </button>
            </div>
            <div class="sgp-remote-row">
              <button class="sgp-btn-remote" type="button">&uarr; Push (origin)</button>
              <button class="sgp-btn-remote" type="button">&darr; Pull (ff-only)</button>
            </div>
          </div>
        </div>

        <!-- Right: Standard Diff Viewer -->
        <div class="diff-col">
          <div class="col-head">
            <div class="diff-meta">
              <span class="diff-filename">internal/engine/merge_base.go</span>
              <span class="diff-stat"><span class="s-add">+22</span> <span class="s-del">−4</span></span>
            </div>
            <div class="diff-controls">
              <div class="view-toggles" role="tablist">
                <button class="toggle-btn on" id="btn-diff-split" type="button">split</button>
                <button class="toggle-btn" id="btn-diff-unified" type="button">unified</button>
              </div>
              <span class="diff-chord"><kbd class="mod-key">Ctrl</kbd><kbd>D</kbd></span>
            </div>
          </div>

          <!-- Split view container -->
          <div class="diff-viewport" id="diff-split-view">
            <div class="diff-split">
              <!-- Left pane: HEAD -->
              <div class="diff-pane diff-pane-old">
                <div class="pane-hdr"><span>HEAD (committed)</span><span>r.64</span></div>
                <div class="diff-lines">
                  <div class="dline"><span class="dln">61</span><span class="dmark"> </span><span class="dtx"><span class="k">func</span> findBase(head, target string) string {'{'}</span></div>
                  <div class="dline"><span class="dln">62</span><span class="dmark"> </span><span class="dtx">  <span class="c">// standard linear revwalk</span></span></div>
                  <div class="dline dline-del"><span class="dln">63</span><span class="dmark">−</span><span class="dtx">  <span class="k">return</span> execGitMergeBase(head, target)</span></div>
                  <div class="dline"><span class="dln">64</span><span class="dmark"> </span><span class="dtx">{'}'}</span></div>
                </div>
              </div>

              <!-- Right pane: Working Tree -->
              <div class="diff-pane diff-pane-new">
                <div class="pane-hdr"><span>Staged Changes (index)</span><span class="s-mod">M</span></div>
                <div class="diff-lines">
                  <div class="dline"><span class="dln">61</span><span class="dmark"> </span><span class="dtx"><span class="k">func</span> findBase(head, target string) string {'{'}</span></div>
                  <div class="dline"><span class="dln">62</span><span class="dmark"> </span><span class="dtx">  <span class="c">// fast path: check commit graph cache</span></span></div>
                  <div class="dline dline-add"><span class="dln">63</span><span class="dmark">+</span><span class="dtx">  <span class="k">if</span> base, ok := fastBaseCache(head); ok {'{'}</span></div>
                  <div class="dline dline-add"><span class="dln">64</span><span class="dmark">+</span><span class="dtx">      <span class="k">return</span> base</span></div>
                  <div class="dline dline-add"><span class="dln">65</span><span class="dmark">+</span><span class="dtx">  {'}'}</span></div>
                  <div class="dline"><span class="dln">66</span><span class="dmark"> </span><span class="dtx">  <span class="k">return</span> execGitMergeBase(head, target)</span></div>
                  <div class="dline"><span class="dln">67</span><span class="dmark"> </span><span class="dtx">{'}'}</span></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Unified view container (hidden by default) -->
          <div class="diff-viewport is-hidden" id="diff-unified-view">
            <div class="diff-pane diff-unified">
              <div class="pane-hdr"><span>unified diff · @@ -61,4 +61,7 @@</span><span>staged</span></div>
              <div class="diff-lines">
                <div class="dline"><span class="dln">61</span><span class="dln">61</span><span class="dmark"> </span><span class="dtx"><span class="k">func</span> findBase(head, target string) string {'{'}</span></div>
                <div class="dline dline-del"><span class="dln">63</span><span class="dln"> </span><span class="dmark">−</span><span class="dtx">  <span class="k">return</span> execGitMergeBase(head, target)</span></div>
                <div class="dline dline-add"><span class="dln"> </span><span class="dln">63</span><span class="dmark">+</span><span class="dtx">  <span class="k">if</span> base, ok := fastBaseCache(head); ok {'{'}</span></div>
                <div class="dline dline-add"><span class="dln"> </span><span class="dln">64</span><span class="dmark">+</span><span class="dtx">      <span class="k">return</span> base</span></div>
                <div class="dline dline-add"><span class="dln"> </span><span class="dln">65</span><span class="dmark">+</span><span class="dtx">  {'}'}</span></div>
                <div class="dline"><span class="dln">64</span><span class="dln">66</span><span class="dmark"> </span><span class="dtx">  <span class="k">return</span> execGitMergeBase(head, target)</span></div>
                <div class="dline"><span class="dln">65</span><span class="dln">67</span><span class="dmark"> </span><span class="dtx">{'}'}</span></div>
              </div>
            </div>
          </div>

          <div class="diff-foot">
            <span class="df-note">Per-file stage ticks in tree · Fast-forward only pulls prevent detached conflicts</span>
            <span class="df-tag">pure shell-out git</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 3 Core Pillars -->
    <div class="git-pillars">
      {pillars.map((p) => (
        <article class="pillar-cell reveal">
          <div class="pil-top">
            <span class="pil-num">{p.num}</span>
            <span class="pil-tag">{p.tag}</span>
          </div>
          <h3 class="pil-title">{p.title}</h3>
          <h4 class="pil-sub">{p.sub}</h4>
          <p class="pil-body">{p.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Interactive mode switching and tab controls for Git showcase
  const initGitShowcase = () => {
    // Mode switcher: PR review vs Working Tree / Git Panel
    const tabModePr = document.getElementById('tab-mode-pr');
    const tabModeGit = document.getElementById('tab-mode-git');
    const viewModePr = document.getElementById('view-mode-pr');
    const viewModeGit = document.getElementById('view-mode-git');
    const summaryPr = document.getElementById('showcase-summary-pr');
    const summaryGit = document.getElementById('showcase-summary-git');

    if (tabModePr && tabModeGit && viewModePr && viewModeGit && summaryPr && summaryGit) {
      tabModePr.addEventListener('click', () => {
        tabModePr.classList.add('on');
        tabModeGit.classList.remove('on');
        viewModePr.classList.remove('is-hidden');
        viewModeGit.classList.add('is-hidden');
        summaryPr.classList.remove('is-hidden');
        summaryGit.classList.add('is-hidden');
      });

      tabModeGit.addEventListener('click', () => {
        tabModeGit.classList.add('on');
        tabModePr.classList.remove('on');
        viewModeGit.classList.remove('is-hidden');
        viewModePr.classList.add('is-hidden');
        summaryGit.classList.remove('is-hidden');
        summaryPr.classList.add('is-hidden');
      });
    }

    // Tree filter toggle in Git panel view
    const btnTreeAll = document.getElementById('btn-tree-all');
    const btnTreeChanged = document.getElementById('btn-tree-changed');
    const tree = document.getElementById('git-mock-tree');

    if (btnTreeAll && btnTreeChanged && tree) {
      btnTreeAll.addEventListener('click', () => {
        btnTreeAll.classList.add('on');
        btnTreeChanged.classList.remove('on');
        tree.classList.remove('filter-changed');
      });

      btnTreeChanged.addEventListener('click', () => {
        btnTreeChanged.classList.add('on');
        btnTreeAll.classList.remove('on');
        tree.classList.add('filter-changed');
      });
    }

    // Diff split / unified toggle
    const btnSplit = document.getElementById('btn-diff-split');
    const btnUnified = document.getElementById('btn-diff-unified');
    const viewSplit = document.getElementById('diff-split-view');
    const viewUnified = document.getElementById('diff-unified-view');

    if (btnSplit && btnUnified && viewSplit && viewUnified) {
      btnSplit.addEventListener('click', () => {
        btnSplit.classList.add('on');
        btnUnified.classList.remove('on');
        viewSplit.classList.remove('is-hidden');
        viewUnified.classList.add('is-hidden');
      });

      btnUnified.addEventListener('click', () => {
        btnUnified.classList.add('on');
        btnSplit.classList.remove('on');
        viewUnified.classList.remove('is-hidden');
        viewSplit.classList.add('is-hidden');
      });
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGitShowcase);
  } else {
    initGitShowcase();
  }
</script>

<style>
  .git-showcase {
    background: var(--bg);
    border: 1px solid var(--bdr);
    margin-bottom: 24px;
  }

  .mode-selectors {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .mode-tab {
    display: flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--bdr);
    background: var(--bg);
    color: var(--txt-3);
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 10px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mode-tab:hover {
    color: var(--txt);
    border-color: var(--bdr-hi);
  }

  .mode-tab.on {
    background: var(--surface-2);
    border-color: var(--amber);
    color: var(--amber);
    font-weight: 600;
  }

  .tab-ico {
    font-size: 10px;
  }

  .mode-pill {
    font-size: 9px;
    padding: 1px 4px;
    border-radius: 2px;
    background: var(--surface);
    color: var(--txt-4);
  }

  .pill-pr {
    background: rgba(187, 154, 247, 0.18);
    color: var(--violet);
    font-weight: 700;
  }

  .git-status-summary {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: var(--txt-3);
  }

  .git-status-summary b {
    color: var(--amber);
    font-weight: 500;
  }

  .gstat-pill {
    font-size: 9.5px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 2px;
    text-transform: uppercase;
  }

  .badge-open {
    color: var(--green);
    background: rgba(158, 206, 106, 0.15);
  }

  .gstat-repo {
    font-weight: 600;
    color: var(--txt);
  }

  .gstat-branch {
    color: var(--txt-4);
    font-family: var(--font-mono);
  }

  .gstat-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 6px var(--amber-glow);
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: 290px minmax(0, 1fr);
    background: var(--bdr);
    gap: 1px;
  }

  .showcase-grid.is-hidden {
    display: none;
  }

  .tree-col,
  .diff-col {
    background: var(--bg);
    display: flex;
    flex-direction: column;
  }

  .col-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 38px;
    padding: 0 12px;
    border-bottom: 1px solid var(--bdr);
    background: var(--bg-elev);
    font-size: 11px;
    color: var(--txt-3);
  }

  .col-title-pr {
    font-weight: 600;
    color: var(--txt);
  }

  .view-toggles {
    display: flex;
    gap: 2px;
    background: var(--bg);
    border: 1px solid var(--bdr);
    padding: 1px;
  }

  .toggle-btn {
    border: 0;
    background: transparent;
    color: var(--txt-3);
