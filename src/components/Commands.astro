---
const groups = [
  {
    name: 'workflows',
    rows: [
      ['px0 workflows new', 'Turn a sentence into a workflow'],
      ['px0 workflows run', 'Run one now, or pick from a list'],
      ['px0 workflows edit', 'Revise the request and rebuild it'],
      ['px0 workflows list', 'Everything you can run'],
    ],
  },
  {
    name: 'ask &amp; memory',
    rows: [
      ['px0 ask', 'Ask anything, and px0 routes it'],
      ['px0 ask --continue', 'Carry on the last conversation'],
      ['px0 memory list', 'What px0 knows about you'],
      ['px0 memory suggest', 'What it thinks it should remember'],
    ],
  },
  {
    name: 'brain',
    rows: [
      ['px0 brain add', 'Save a URL, PDF, doc, or transcript'],
      ['px0 brain ask', 'Answer a question from your library'],
      ['px0 brain search', 'Retrieve the matching passages'],
      ['px0 brain reindex', 'Rebuild the retrieval index'],
    ],
  },
  {
    name: 'guidelines',
    rows: [
      ['px0 guidelines list', 'Every convention, numbered'],
      ['px0 guidelines edit', 'Reword a draft into your voice'],
      ['px0 guidelines show', 'Print one, verbatim'],
      ['px0 guidelines log', 'One claim’s edit history'],
    ],
  },
  {
    name: 'runs &amp; changes',
    rows: [
      ['px0 runs', 'Browse, filter, and re-run past runs'],
      ['px0 runs why', 'How a run reached its result'],
      ['px0 runs mark', 'Say whether the output was any good'],
      ['px0 changes revert', 'Undo a recorded change'],
    ],
  },
  {
    name: 'inbox &amp; approvals',
    rows: [
      ['px0 inbox', 'What your scheduled workflows produced'],
      ['px0 approvals', 'Writes drafted and waiting for you'],
      ['px0 approvals show', 'Exactly what would be sent'],
      ['px0 approvals approve', 'Send precisely that'],
    ],
  },
  {
    name: 'getting better',
    rows: [
      ['px0 workflows health', 'What a workflow\u2019s own runs say about it'],
      ['px0 workflows improve', 'Revise it from what those runs did'],
      ['px0 workflows replay', 'Check a revision against real past inputs'],
      ['px0 store sync', 'Share a store between your machines'],
    ],
  },
  {
    name: 'the install',
    rows: [
      ['px0 daemon install', 'Run workflows on a schedule'],
      ['px0 tools list --status', 'What can be called, and what is ready'],
      ['px0 status', 'Whether anything needs attention'],
      ['px0 doctor', 'Check that everything is wired up'],
    ],
  },
];
---

<section class="section section--tight" id="commands">
  <div class="container">
    <div class="cmd-head reveal">
      <div>
        <span class="eyebrow">the whole surface</span>
        <h2 class="h-section">Entity first, then the verb</h2>
      </div>
      <p class="sub">
        Every command reads as entity then verb, and <code class="inline-code">--help</code> works on
        every one of them. The one exception is <code class="inline-code">px0 ask</code>, which routes
        across all of them and so names none.
      </p>
    </div>

    <div class="cmd-groups">
      {groups.map((g) => (
        <div class="cmd-group reveal">
          <h3 set:html={g.name}></h3>
          <ul>
            {g.rows.map(([cmd, desc]) => (
              <li>
                <code>{cmd}</code>
                <span>{desc}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cmd-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 44px;
  }

  .cmd-head .sub {
    max-width: 320px;
    font-size: 14px;
    padding-bottom: 6px;
  }

  .cmd-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 34px 30px;
  }

  .cmd-group h3 {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--amber);
    padding-bottom: 10px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--bdr);
  }

  .cmd-group ul {
    list-style: none;
  }

  .cmd-group li {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px 10px 10px 8px;
    margin: 0 -8px;
    border-radius: var(--r-sm);
    transition: background 0.16s;
  }

  .cmd-group li:hover {
    background: var(--surface);
  }

  .cmd-group code {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--txt);
  }

  .cmd-group span {
    font-size: 12.5px;
    color: var(--txt-3);
  }

  @media (max-width: 900px) {
    .cmd-head { flex-direction: column; align-items: flex-start; gap: 16px; }
    .cmd-head .sub { max-width: 100%; }
    .cmd-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .cmd-groups { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  }
</style>
