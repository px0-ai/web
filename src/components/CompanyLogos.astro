---

<div class="hero-logos-strip" aria-label="Companies using px0">
  <div class="logos-head">
    <span class="logos-dot" aria-hidden="true"></span>
    <span class="logos-title">Engineers at these companies use px0</span>
  </div>

  <div class="marquee-wrapper">
    <div class="marquee-track">
      <!-- First copy -->
      <div class="marquee-group">
        {companies.map((c) => (
          <div class="logo-item" title={c.name}>
            <svg class="logo-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" set:html={c.svg}></svg>
            <span class="logo-name">{c.name}</span>
          </div>
        ))}
      </div>

      <!-- Second copy for seamless infinite animation loop -->
      <div class="marquee-group" aria-hidden="true">
        {companies.map((c) => (
          <div class="logo-item" title={c.name}>
            <svg class="logo-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" set:html={c.svg}></svg>
            <span class="logo-name">{c.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .hero-logos-strip {
    position: relative;
    margin: 64px 0 32px;
    padding: 28px 0 22px;
    border-top: 1px solid var(--bdr);
    border-bottom: 1px solid var(--bdr);
    background: linear-gradient(180deg, var(--surface) 0%, transparent 100%);
    overflow: hidden;
  }

  .logos-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 16px;
    text-align: center;
  }

  .logos-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
  }

  .logos-title {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--txt-3);
    margin: 0;
  }

  .marquee-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 45s linear infinite;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    gap: 32px;
    padding-right: 32px;
  }

  .logo-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 1px solid transparent;
    border-radius: 4px;
    color: var(--txt-3);
    cursor: default;
    user-select: none;
    transition: color 0.15s, border-color 0.15s, background-color 0.15s, transform 0.15s;
  }

  .logo-item:hover {
    color: var(--txt);
    border-color: var(--bdr);
    background: var(--bg-elev);
    transform: translateY(-1px);
  }

  .logo-icon {
    flex-shrink: 0;
    color: inherit;
    transition: color 0.15s;
  }

  .logo-item:hover .logo-icon {
    color: var(--amber);
  }

  .logo-name {
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: inherit;
    white-space: nowrap;
  }

  @keyframes marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .marquee-track::-webkit-scrollbar {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero-logos-strip {
      margin: 48px 0 24px;
      padding: 20px 0 18px;
    }
    .logos-title {
      font-size: 10px;
      letter-spacing: 0.08em;
    }
    .marquee-group {
      gap: 20px;
      padding-right: 20px;
    }
    .logo-item {
      padding: 4px 8px;
      gap: 6px;
    }
    .logo-name {
      font-size: 12px;
    }
  }
</style>
