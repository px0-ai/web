---
---

<section class="section" id="dashboard">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">insights</span>
      <h2 class="h-section">Visualize agent performance.</h2>
      <p class="sub">
        Watch your workflows in real time. Track execution success, failure rates, and review detailed timelines of every action the agent takes to reach its goal.
      </p>
    </div>

    <div class="dashboard-grid reveal">
      <div class="panel chart-panel">
        <header class="panel-header">
          <h3>Executions</h3>
          <span class="tag">Last 7 Days</span>
        </header>
        <div class="canvas-wrapper">
          <canvas id="executionsChart"></canvas>
        </div>
      </div>

      <div class="panel timeline-panel">
        <header class="panel-header">
          <h3>Task Timeline</h3>
          <span class="tag">triaged-bug-ticket #82</span>
        </header>
        <div class="timeline">
          <div class="t-step ok">
            <div class="t-time">09:14:02</div>
            <div class="t-marker"></div>
            <div class="t-content">
              <strong>Event Triggered</strong>
              <span>watch: sentry.poll_alerts</span>
            </div>
          </div>
          <div class="t-step ok">
            <div class="t-time">09:14:15</div>
            <div class="t-marker"></div>
            <div class="t-content">
              <strong>Fetched Context</strong>
              <span>sqlite FTS5 semantic search</span>
            </div>
          </div>
          <div class="t-step warn">
            <div class="t-time">09:14:38</div>
            <div class="t-marker"></div>
            <div class="t-content">
              <strong>Linear API Retry</strong>
              <span>Rate limit hit. Backing off...</span>
            </div>
          </div>
          <div class="t-step ok">
            <div class="t-time">09:14:41</div>
            <div class="t-marker"></div>
            <div class="t-content">
              <strong>Ticket Created</strong>
              <span>Linear issue TCK-102 opened</span>
            </div>
          </div>
          <div class="t-step active">
            <div class="t-time">09:14:45</div>
            <div class="t-marker"></div>
            <div class="t-content">
              <strong>Drafting Summary</strong>
              <span>slack.post_message</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dashboard-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 20px;
    margin-top: 20px;
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--bdr);
    border-radius: var(--r-lg);
    padding: 24px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .panel-header h3 {
    font-family: var(--display);
    font-size: 18px;
    font-weight: 600;
    color: var(--txt);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .tag {
    font-family: var(--mono);
    font-size: 11px;
    background: var(--code-bg);
    border: 1px solid var(--bdr);
    padding: 4px 8px;
    border-radius: var(--r-sm);
    color: var(--txt-2);
  }

  .canvas-wrapper {
    flex-grow: 1;
    position: relative;
    min-height: 280px;
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 64px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: var(--bdr);
    z-index: 0;
  }

  .t-step {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    position: relative;
    z-index: 1;
  }

  .t-time {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--txt-3);
    width: 48px;
    padding-top: 2px;
    text-align: right;
    flex-shrink: 0;
  }

  .t-marker {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--code-bg);
    border: 2px solid var(--bdr);
    margin-top: 4px;
    flex-shrink: 0;
  }

  .ok .t-marker {
    background: var(--surface);
    border-color: var(--green, #2ea043);
  }

  .warn .t-marker {
    background: var(--surface);
    border-color: var(--amber, #d29922);
  }

  .active .t-marker {
    background: var(--amber, #d29922);
    border-color: var(--amber, #d29922);
    box-shadow: 0 0 10px color-mix(in srgb, var(--amber) 50%, transparent);
  }

  .t-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .t-content strong {
    font-size: 14px;
    color: var(--txt);
    font-weight: 500;
  }

  .t-content span {
    font-size: 13px;
    color: var(--txt-2);
  }

  @media (max-width: 900px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import Chart from 'chart.js/auto';

  // We use Astro's `page-load` event if ViewTransitions is on, 
  // or fall back to DOMContentLoaded. Just wrap in a simple setup block.
  function initChart() {
    const ctx = document.getElementById('executionsChart');
    if (!ctx) return;
    
    // Destroy previous Chart instance if it exists (for Astro HMR/ViewTransitions)
    let chartStatus = Chart.getChart("executionsChart");
    if (chartStatus != undefined) {
      chartStatus.destroy();
    }

    // Get CSS roots for styling the chart
    const style = getComputedStyle(document.documentElement);
    const textColor = style.getPropertyValue('--txt-2').trim() || '#8b949e';
    const gridColor = style.getPropertyValue('--bdr').trim() || '#30363d';
    const accentColor = style.getPropertyValue('--cyan').trim() || '#2f81f7';
    const failColor = style.getPropertyValue('--amber').trim() || '#d29922';
    const fontPrimary = style.getPropertyValue('--sans').trim() || 'system-ui, sans-serif';

    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
        datasets: [
          {
            label: 'Successful',
            data: [42, 56, 38, 64, 49, 12, 14],
            backgroundColor: accentColor,
            borderRadius: 4,
            barPercentage: 0.6
          },
          {
            label: 'Failed',
            data: [2, 1, 3, 0, 4, 0, 1],
            backgroundColor: failColor,
            borderRadius: 4,
            barPercentage: 0.6
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'top',
            labels: {
              color: textColor,
              font: { family: fontPrimary, size: 12 },
              usePointStyle: true,
              boxWidth: 8
            }
          },
          tooltip: {
            backgroundColor: '#161b22', /* dark fallback */
            titleFont: { family: fontPrimary, size: 13 },
            bodyFont: { family: fontPrimary, size: 13 },
            borderColor: gridColor,
            borderWidth: 1,
            padding: 10,
            cornerRadius: 4
          }
        },
        scales: {
          y: {
            stacked: true,
            grid: { color: gridColor },
            border: { display: false },
            ticks: {
              color: textColor,
              font: { family: fontPrimary, size: 11 }
            }
          },
          x: {
            stacked: true,
            grid: { display: false },
            border: { display: false },
            ticks: {
              color: textColor,
              font: { family: fontPrimary, size: 11 }
            }
          }
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initChart);
  document.addEventListener('astro:page-load', initChart);
</script>
